  botBing   Int? @map("bot_bing")
  botMeta   Int? @map("bot_meta")
  botAi     Int? @map("bot_ai")
  botBad    Int? @map("bot_bad") // Blocked/limited bots

  // Performance
  avgResponseTimeMs Int? @map("avg_response_time_ms")
  slowRequests      Int? @map("slow_requests")
  errors5xx         Int? @map("errors_5xx")
  errors4xx         Int? @map("errors_4xx")

  // MySQL
  mysqlCpuPercent  Decimal? @map("mysql_cpu_percent") @db.Decimal(5, 2)
  mysqlConnections Int?     @map("mysql_connections")
  mysqlSlowQueries Int?     @map("mysql_slow_queries")

  // SSL
  sslExpiryDays Int?    @map("ssl_expiry_days")
  sslIssuer     String? @map("ssl_issuer")

  // Health score
  healthScore Int? @default(100) @map("health_score") // 0-100

  topUrls              Json?    @map("top_urls")
  topIps               Json?    @map("top_ips")
  topReferers          Json?    @map("top_referers")
  countries            Json?    @map("countries")
  cities               Json?    @map("cities")
  searchEngines        Json?    @map("search_engines")
  cacheHitRate         Decimal? @map("cache_hit_rate") @db.Decimal(5, 2)
  bandwidthBytes       BigInt?  @map("bandwidth_bytes")
  phpExecutionTimeMs   Int?     @map("php_execution_time_ms")
  mysqlExecutionTimeMs Int?     @map("mysql_execution_time_ms")

  websiteCpuPercent Decimal? @map("website_cpu_percent") @db.Decimal(5, 2)
  infraCpuPercent   Decimal? @map("infra_cpu_percent") @db.Decimal(5, 2)
  unknownCpuPercent Decimal? @map("unknown_cpu_percent") @db.Decimal(5, 2)
  unknownProcesses  Json?    @map("unknown_processes")

