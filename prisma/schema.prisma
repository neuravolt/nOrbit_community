  status               String       @default("creating") @db.VarChar(50)
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  @@index([nodeId])
  @@map("github_roadmap_repos")
}

model ChallengeTestSuite {
  id         String                @id @default(uuid())
  // Phase C3 (Roadmap Runtime Verification Architecture — full-pipeline self-test): nullable
  // going forward, same backfill/loose-reference convention every other polymorphic model in
  // this schema already uses (existing rows backfilled targetType: 'roadmap_node', targetId:
  // <their nodeId>) — a task-scoped contract can finally get real hidden-test coverage instead
  // of BrokenSolutionsValidationService's pre-existing `!contract.nodeId` stub.
  nodeId     String?               @map("node_id")
  node       LaunchpadRoadmapNode? @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  targetType String                @default("roadmap_node") @map("target_type")
  targetId   String?               @map("target_id")
  name       String
  stage      String // "build", "test", "security", "lint", "ai_review"
  weight     Float                 @default(0)
  testCode   String                @map("test_code") @db.Text
  timeoutSec Int                   @default(30) @map("timeout_sec")
  points     Int                   @default(10)
  isRequired Boolean               @default(true) @map("is_required")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  // Launchpad Phase 5B, Slice 5B-7: hidden tests can now also come from AI generation, not only
  // manual admin authoring — these must be reviewed before they ever run against a real student
  // submission. Default "approved" is deliberate: every EXISTING row (manually authored, already
  // trusted under the pre-5B-7 model) and every future manually-created row stays immediately
  // usable with zero behavior change — only the new AI-generation path ever creates a row with
  // "pending-review". generationJobId links back to the LaunchpadAiGenerationJob that drafted it
  // (no enforced FK, same loose-reference style as LaunchpadAiGenerationJob.careerId already
  // uses); challengeVersion snapshots the node's challengeVersion at authoring time.
  generationJobId  String? @map("generation_job_id")
  // Slice 5B-14: "validated"/"rejected-by-validation" join the pre-existing "approved" |
  // "pending-review" | "rejected" values — the Broken Solutions pipeline's own outcome states,
  // sitting between "pending-review" and a human's own approveGenerated()/rejectGenerated() call.
  reviewStatus     String  @default("approved") @map("review_status")
  challengeVersion Int?    @map("challenge_version")

  // Slice 5B-14 (Broken Solutions validation pipeline): which contract's expectedSolution/
  // brokenSolutions this test was last validated against — no enforced requirement that one
  // exists (a node with no approved contract simply never runs this pipeline, per the rollback
  // note: "disabling the pipeline reverts to 5B-7's existing manual-review-only behavior").
  contractId               String?                                 @map("contract_id")
  contract                 LaunchpadChallengeVerificationContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  validatedAgainstExpected Boolean                                 @default(false) @map("validated_against_expected")
  validatedAgainstBroken   Boolean                                 @default(false) @map("validated_against_broken")
  validationScore          Float?                                  @map("validation_score")

  @@index([nodeId])
  @@index([targetType, targetId])
  @@map("challenge_test_suites")
}

model ChallengeEvaluationReport {
  id                      String                @id @default(uuid())
  submissionId            String?               @map("submission_id") // nullable: row is created at Start (assignment), before a repo/submission exists
  studentId               String                @map("student_id")
  // Phase A (Roadmap): nullable going forward — only populated (with the real FK) when
  // targetType is 'roadmap_node'. Kept, not removed, so every existing query/relation against
  // nodeId/node keeps working unchanged for the Node-based challenge flow.
  nodeId                  String?               @map("node_id")
  node                    LaunchpadRoadmapNode? @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  // Phase A (Roadmap): polymorphic target, mirrors LaunchpadAiGenerationJob.targetType/targetId
  // (this repo's established pattern for "one engine, multiple target entity types" — see that
  // model's own doc comment). No enforced FK on targetId by design, same loose-reference style.
  // Existing rows are backfilled targetType: 'roadmap_node', targetId: <their nodeId>.
  targetType              String                @default("roadmap_node") @map("target_type")
  targetId                String?               @map("target_id")
  // Phase A (Roadmap): loose reference to the LaunchpadSubmission row this report corresponds
  // to — only ever set for targetType 'launchpad_task' (the roadmap_node flow has no submission
  // row at all, it submits a bare repoUrl). Lets final-score.validator.ts update the right
  // submission's status/pointsAwarded once verification completes.
  taskSubmissionId        String?               @map("task_submission_id")
  // Phase B1 (Roadmap Runtime Verification Architecture): loose reference to the
  // ChallengeInstance this report was evaluated against, when one was involved — same
  // no-enforced-FK style targetId already uses. Null for every report from the pre-existing
  // direct node/task flow.
  instanceId              String?               @map("instance_id")
  startedAt               DateTime              @map("started_at") // set at Start (Click Start), not at submit — this is the "assignedAt" moment
  submitted               Boolean               @default(false) // false between Start and actual GitHub submission
  submittedAt             DateTime?             @map("submitted_at")
  completedAt             DateTime?             @map("completed_at")
  durationMs              Int?                  @map("duration_ms")
  stageResults            Json                  @default("[]") @map("stage_results")
  finalScore              Float?                @map("final_score")
  passed                  Boolean               @default(false)
  autoApproved            Boolean               @default(false) @map("auto_approved")
  mentorReviewReq         Boolean               @default(false) @map("mentor_review_req")
  // Launchpad Phase 5B, Slice 5B-10: true only for reports that ran through code-review.processor.ts's
  // legacy handleEvaluation path (the technology has no PatternConfig) — where finalScore is a
  // 0.4/0.6 auto/AI blend, not the deterministic Verification Engine's real weighted formula.
  // Default false means every existing report and every report scored by the real engine is
  // unaffected; this is the explicit, queryable "unverified — no automated evidence for this
  // technology" flag §10 of the plan calls for, not an inference from finalScore's shape.
  noDeterministicCoverage Boolean               @default(false) @map("no_deterministic_coverage")
  // Launchpad Phase 5B, Slice 5B-16: sandboxHeadSha from git-forensics.validator.ts's own
  // final-code-correspondence check (5B-13), surfaced as its own queryable column instead of
  // only living inside stageResults JSON — same "give it a real column" treatment
  // developmentEvidenceScore already got in 5B-13.
  githubCommitSha         String?               @map("github_commit_sha")
  // The §9 decision-matrix's computed label (PASS | CONDITIONAL_PASS | FAIL | MENTOR_REVIEW),
  // set once per report from FinalScoreValidator's run. overrideDecision is a mentor's explicit
  // PASS/FAIL call recorded separately — set by MentorApprovalService — so the originally
  // computed routing outcome is never silently rewritten, only annotated.
  decision                String?
  overrideDecision        String?               @map("override_decision")
  mentorStatus            String?               @map("mentor_status") // "pending", "approved", "rejected"
  mentorFeedback          String?               @map("mentor_feedback") @db.Text
  mentorOverrideScore     Float?                @map("mentor_override_score") // set only if a mentor changed the auto/AI score
  mentorOverrideReason    String?               @map("mentor_override_reason") @db.Text // required by app logic whenever mentorOverrideScore is set
  mentorReviewerId        String?               @map("mentor_reviewer_id") // real reviewer id — replaces a previous hardcoded 'mentor_id' placeholder
  aiScore                 Float?                @map("ai_score")
  aiFeedback              Json?                 @map("ai_feedback")
  attemptNumber           Int                   @default(1) @map("attempt_number")
  peerReviewerId          String?               @map("peer_reviewer_id")
  peerReviewScore         Float?                @map("peer_review_score")
  peerFeedback            String?               @map("peer_feedback") @db.Text

  // Verification Engine additions (Part 7): manifest + immutable challenge blueprint, captured at Start
  manifestHash       String? @map("manifest_hash")
  challengeVersionId Int     @default(1) @map("challenge_version_id") // snapshot of LaunchpadRoadmapNode.challengeVersion at Start
  challengeBlueprint Json?   @map("challenge_blueprint") // frozen {requirements, evaluationCriteria, expectedSkills, difficulty, multiplier}
  repositoryId       String? @map("repository_id") // bound GithubRepository.id once a repo is submitted — used by anti-cheat reuse/rename checks
  repositoryName     String? @map("repository_name") // "owner/name" snapshot at submission time, for rename detection

  scoreVersions ChallengeScoreVersion[]

  // Launchpad Phase 5B, Slice 5B-13: git-forensics.validator.ts's own deterministic 0-100 score
  // (already computed today, start-at-100 minus deterministic penalties), now also persisted as
  // its own queryable column instead of only living inside stageResults JSON and feeding
  // computeConfidence internally. Zero AI involvement. Nullable — null until the git-forensics
  // stage actually runs for this report (or for any report from before this slice shipped).
  developmentEvidenceScore Float? @map("development_evidence_score")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([nodeId])
  @@index([studentId])
  @@index([studentId, nodeId]) // every hot-path lookup (Start, Submit, node-history, trust-score prior-attempts) filters on both together
  @@index([studentId, targetType, targetId]) // Phase A: same hot-path lookup, for task-targeted reports
  @@map("challenge_evaluation_reports")
}

// Replay Engine (Part 8): every recalculation appends a version instead of overwriting finalScore.
model ChallengeScoreVersion {
  id                       String                    @id @default(uuid())
  reportId                 String                    @map("report_id")
  report                   ChallengeEvaluationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  algorithmVersion         Int                       @map("algorithm_version")
  score                    Float
  weights                  Json?
  // Slice 5B-13: carried forward from the report's own developmentEvidenceScore at the moment
  // this version was computed — git-forensics itself is never re-run by a recalculation (Part
  // 8's whole point is no re-clone/re-test), so this is a snapshot of an already-known fact, not
  // a recomputation.
  developmentEvidenceScore Float?                    @map("development_evidence_score")
  // Launchpad Phase 5B, Slice 5B-16 (addition 5/6/7): the three-signal breakdown and §9 decision
  // matrix, snapshotted at the moment this version was computed — same append-only convention as
  // every other column on this row, never updated after insert.
  verificationConfidence   String?                   @map("verification_confidence") // "HIGH" | "MEDIUM" | "LOW" — computeConfidence's own tier, not a fabricated probability
  categoryScores           Json?                     @map("category_scores") // per-stage score breakdown, same shape as final-score.validator's technicalScoreBreakdown
  criticalGatesPassed      Boolean?                  @map("critical_gates_passed") // null when the challenge has no customGates contract — "not applicable", not "failed"
  failedGates              Json?                     @map("failed_gates") // string[] of the customGates requirement strings that did not match
  decision                 String? // PASS | CONDITIONAL_PASS | FAIL | MENTOR_REVIEW — see §9
  computedAt               DateTime                  @default(now()) @map("computed_at")

  @@index([reportId])
  @@map("challenge_score_versions")
}

model PeerReviewAssignment {
  id               String    @id @default(uuid())
  submissionId     String    @map("submission_id")
  evaluatorId      String    @map("evaluator_id")
  status           String    @default("pending") // "pending", "completed", "expired"
  assignedAt       DateTime  @default(now()) @map("assigned_at")
  completedAt      DateTime? @map("completed_at")
  score            Float?
  feedback         String?   @db.Text
  // Phase D2 (Roadmap Runtime Verification Architecture — rubric-based review): structured
  // per-category assessment (functional correctness, code quality, security, architecture,
  // requirements, documentation), additive alongside the pre-existing free-text score/feedback —
  // not a replacement. Null for every assignment completed before this field existed.
  rubricScores     Json?     @map("rubric_scores")
  rewardPoints     Int       @default(0) @map("reward_points")
  rewardStatus     String    @default("pending") @map("reward_status") // "pending", "awarded"
  // Phase D3 (Reviewer Reputation Engine): whether this specific review's decision was later
  // confirmed correct or overturned — set only once an outcome is known (a dispute resolves, or
  // a mentor overrides an escalated peer decision), null until then. ReviewerReputationService
  // computes peerReviewAccuracy from these across a reviewer's recent outcome-known assignments,
  // never from raw review count.
  outcomeAgreement Boolean?  @map("outcome_agreement")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([submissionId])
  @@index([evaluatorId])
  @@map("peer_review_assignments")
}

model GuardianAgent {
  id                      String      @id @default(cuid())
  agentId                 String?     @unique @map("agent_id") // external-facing identifier (e.g. "agent-byovps-xxxx"), distinct from the internal cuid `id`
  name                    String // "Guardian-01"
  serverId                String      @unique @map("server_id") // Link to Asset (VPS)
  status                  AgentStatus @default(INACTIVE)
  version                 String      @default("1.0.0")
  updateChannel           String      @default("stable") @map("update_channel")
  agentSecretHash         String?     @map("agent_secret_hash") // deprecated, unused — see agentSecretEnc
  agentSecretEnc          String?     @map("agent_secret_enc") // AES-256-GCM encrypted (ENCRYPTION_KEY) — HMAC verification needs the real secret, not a one-way hash of it
  pendingSecretEnc        String?     @map("pending_secret_enc")
  pendingSecretExpiresAt  DateTime?   @map("pending_secret_expires_at")
  previousSecretHash      String?     @map("previous_secret_hash") // one-way hash of the just-rotated-out secret — audit trail only, never used for verification
  previousSecretRotatedAt DateTime?   @map("previous_secret_rotated_at")
  agentFingerprint        String?     @map("agent_fingerprint")
  machineId               String?     @map("machine_id")
  hostname                String?
  publicIp                String?     @map("public_ip")
  registeredIp            String?     @map("registered_ip")
  protocolVersion         Int?        @map("protocol_version")
  osInfo                  Json?       @map("os_info")
  lastHeartbeat           DateTime?   @map("last_heartbeat")
  lastSequence            Int         @default(0) @map("last_sequence")
  connectedAt             DateTime?   @map("connected_at")
  deletedAt               DateTime?   @map("deleted_at")
  sshKeyPath              String?     @map("ssh_key_path") // Path to SSH key
  installPath             String      @default("/opt/guardian") @map("install_path")

  // Capabilities
  canScan    Boolean @default(true) @map("can_scan")
  canMonitor Boolean @default(true) @map("can_monitor")
  canProtect Boolean @default(true) @map("can_protect")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  server            Asset                      @relation("AgentToHostServer", fields: [serverId], references: [id], onDelete: Cascade)
  monitoredAssets   Asset[]                    @relation("AgentToMonitoredAssets")
  discoveries       GuardianDiscovery[]
  monitors          GuardianMonitor[]
  alerts            GuardianAlert[]
  nginxConfigs      NginxConfig[]              @relation("AgentToNginxConfig")
  securityStatus    GuardianSecurityStatus?
  malwareScans      GuardianMalwareScan[]
  autonomousActions AutonomousAction[]
  commands          GuardianCommand[]
  wordpressScans    GuardianWordPressScan[]
  quarantineRecords GuardianQuarantineRecord[]

  // Guardian Core load-safe architecture (Phase 1)
  securityFindings      SecurityFinding[]
  fleetOperationTargets FleetOperationTarget[]

  @@map("guardian_agents")
}

// Pull-based remote operations for BYOVPS agents — the agent has no inbound
// access (no SSH), so admin-queued work is delivered through the heartbeat
// response and results are reported back via a separate HMAC-authenticated
// endpoint. commandType/status are deliberately plain String (not Postgres
// enums) so Phase 2 command types can be added without a schema migration —
// see GUARDIAN_BYOVPS_PLAN.md for the full design.
model GuardianCommand {
  id          String    @id @default(cuid())
  agentId     String    @map("agent_id")
  commandType String    @map("command_type") // SERVICE_RESTART | SERVICE_START | SERVICE_STOP | DIAGNOSTICS | LOGS | PROCESS_LIST | DISCOVERY | REMEDIATION
  payload     Json? // closed, per-commandType shape validated in code — never a free-text command string
  status      String    @default("PENDING") // PENDING -> DELIVERED -> RUNNING -> SUCCESS | FAILED | CANCELLED | EXPIRED
  requestedBy String    @map("requested_by")
  requestedAt DateTime  @default(now()) @map("requested_at")
  deliveredAt DateTime? @map("delivered_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  stdout      String?   @db.Text
  stderr      String?   @db.Text
  exitCode    Int?      @map("exit_code")
  durationMs  Int?      @map("duration_ms")
  retryCount  Int       @default(0) @map("retry_count")
  expiresAt   DateTime  @map("expires_at")

  agent GuardianAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, status])
  @@map("guardian_commands")
}

model GuardianInstallToken {
  id              String    @id @default(cuid())
