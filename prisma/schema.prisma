generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                      @id @default(uuid())
  email                   String                      @unique
  passwordHash            String
  firstName               String
  lastName                String
  avatarUrl               String?
  isActive                Boolean                     @default(true)
  role                    RoleField                   @default(CLIENT)
  lastLoginAt             DateTime?
  teamId                  String?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  deletedAt               DateTime?
  amcHourLogs             AmcHourLog[]
  weeklyReportsCompiled   AmcWeeklyReport[]           @relation("CompiledBy")
  attachments             Attachment[]
  auditLogs               AuditLog[]
  bugsAssigned            BugReport[]                 @relation("AssignedBugs")
  comments                Comment[]
  notifications           Notification[]
  quotesSent              Quote[]                     @relation("SentBy")
  tasksAssigned           TaskAssignment[]
  Ticket                  Ticket[]
  timeLogs                TimeLog[]
  team                    Team?                       @relation(fields: [teamId], references: [id])
  userRoles               UserRole[]
  tokenVersion            Int                         @default(1) @map("token_version")
  /// Set when HR created the account with a one-time password; the web app asks for a new one first.
  mustChangePassword      Boolean                     @default(false) @map("must_change_password")
  /// sha256 of the one-time "set your password" link sent to a new employee, and when it stops working.
  inviteTokenHash         String?                     @map("invite_token_hash")
  inviteExpiresAt         DateTime?                   @map("invite_expires_at")
  refreshTokens           RefreshToken[]
  createdRoadmapNodes     RoadmapNode[]               @relation("CreatedNodes")
  technologyProgress      StudentTechnologyProgress[] @relation("UserToTechProgress")
  nodeProgress            StudentNodeProgress[]       @relation("UserToNodeProgress")
  reviewedJobs            AIGenerationJob[]           @relation("JobReviewer")
  evidenceItems           Evidence[]                  @relation("UserEvidence")
  mentorReviewsAsStudent  MentorReview[]              @relation("StudentMentorReviews")
  mentorReviewsHandled    MentorReview[]              @relation("MentorReviewsHandled")
  currentCareerId         String?                     @map("current_career_id") @db.Uuid
  currentCareer           Career?                     @relation("UserCareer", fields: [currentCareerId], references: [id], onDelete: SetNull)
  currentRoleId           String?                     @map("current_role_id") @db.Uuid
  currentRole             CareerRole?                 @relation("UserRole", fields: [currentRoleId], references: [id], onDelete: SetNull)
  // Accounting relations
  purchaseEntries         PurchaseEntry[]             @relation("PurchaseCreatedBy")
  expenseEntries          ExpenseEntry[]              @relation("ExpenseCreatedBy")
  bankTransactions        BankTransaction[]           @relation("BankTxCreatedBy")
  cashTransactions        CashTransaction[]           @relation("CashTxCreatedBy")
  salaryEntriesAsEmployee SalaryEntry[]               @relation("SalaryEmployee")
  salaryEntriesCreated    SalaryEntry[]               @relation("SalaryCreatedBy")

  // HR Module relations
  employmentType    EmploymentType @default(EMPLOYEE)
  hrDocuments       HrDocument[]   @relation("EmployeeHrDocuments")
  attendanceRecords Attendance[]   @relation("EmployeeAttendance")
  attendanceReviews Attendance[]   @relation("AttendanceReviewedBy")
  leaveRequests     LeaveRequest[] @relation("EmployeeLeaves")
  approvedLeaves    LeaveRequest[] @relation("ApprovedLeaves")

  // Enterprise HRMS Architecture Relations
  organizationId                 String?
  organization                   Organization?                   @relation(fields: [organizationId], references: [id])
  reportingManagerId             String?
  reportingManager               User?                           @relation("ReportingManager", fields: [reportingManagerId], references: [id])
  subordinates                   User[]                          @relation("ReportingManager")
  employeeProfile                EmployeeProfile?
  employeeEducations             EmployeeEducation[]
  employeeExperiences            EmployeeExperience[]
  employeeSkills                 EmployeeSkill[]
  employeeSalaries               EmployeeSalary[]
  salaryComponentAssignments     EmployeeSalaryComponent[]
  payrollAdjustments             PayrollAdjustment[]
  holidayCalendarAssignments     HolidayCalendarAssignment[]
  taxExemptions                  TaxExemption[]
  overtimeEntries                OvertimeEntry[]
  employeeDocuments              EmployeeDocument[]
  leaveBalances                  LeaveBalance[]
  leaveLedgerEntries             LeaveLedger[]
  assignedPolicies               EmployeeLeavePolicy[]           @relation("AssignedPoliciesEmployee")
  assignedPoliciesCreated        EmployeeLeavePolicy[]           @relation("AssignedPoliciesCreated")
  delegatorDelegations           ApprovalDelegation[]            @relation("DelegatorUser")
  delegateDelegations            ApprovalDelegation[]            @relation("DelegateUser")
  leaveApprovalSteps             LeaveApprovalStep[]             @relation("StepApprover")
  officeAssetAssignments         OfficeAssetAssignment[]
  expenseClaims                  ExpenseClaim[]                  @relation("ClaimEmployee")
  approvedExpenseClaims          ExpenseClaim[]                  @relation("ApprovedClaims")
  raisedHrTickets                HrHelpdeskTicket[]              @relation("TicketEmployee")
  assignedHrTickets              HrHelpdeskTicket[]              @relation("AssignedAgent")
  performanceGoals               PerformanceGoal[]
  performanceReviews             PerformanceReview[]
  approvalHistories              ApprovalHistory[]
  payslips                       Payslip[]
  notificationPreferences        NotificationPreference[]
  guardianNotificationPreference GuardianNotificationPreference?
  guardianPushSubscriptions      GuardianPushSubscription[]
  notificationLogs               NotificationLog[]

  // Biometric Platform Relations
  biometricProfiles  BiometricProfile[]
  biometricAuditLogs BiometricAuditLog[]
  consentRegistries  ConsentRegistry[]

  // Meetings Module Relations
  createdMeetings        Meeting[]                 @relation("UserCreatedMeetings")
  reviewedManualPayments ManualPaymentSubmission[] @relation("ReviewedManualPayments")
  publishedReleaseNotes  ProjectReleaseNote[]      @relation("PublishedReleaseNotes")

  // NeuraChat Enterprise Collaboration Relations
  chatMemberships        ChatMember[]
  chatMessagesSent       ChatMessage[]
  chatMessageReceipts    ChatMessageReceipt[]
  chatMessageReactions   ChatMessageReaction[]
  chatPinnedMessages     ChatPinnedMessage[]

  // NORBIT SaaS Multi-Tenancy & Customer Auth
  userType                   String                    @default("STAFF")
  emailVerified              Boolean                   @default(true)
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  passwordResetTokenHash     String?
  passwordResetExpiresAt     DateTime?
  activeOrganizationId       String?
  organizationMemberships    OrganizationMember[]      @relation("UserOrganizationMemberships")
  sentInvitations            OrganizationInvitation[]  @relation("UserSentInvitations")
}

model Team {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model Permission {
  id        String           @id @default(uuid())
  resource  String
  action    String
  scope     String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  roles     RolePermission[]

  @@unique([resource, action, scope])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  userRoles   UserRole[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation("OrgAuditLogs", fields: [organizationId], references: [id])
  userId         String?
  action         String
  resourceType   String
  resourceId     String
  metadata       Json?
  severity       String? // INFO | WARNING | SECURITY | CRITICAL — nullable so non-Guardian writers are unaffected
  // Launchpad Phase 5B, Slice 5B-16: structured fields for the content-lifecycle actions (edit/
  // regenerate/approve/reject/restore/publish) that previously buried this in free-form
  // `metadata` JSON. Nullable so every existing writer across the codebase (guardian, biometric,
  // hrms, scheduler, etc.) is unaffected — these are additive, not a replacement for `metadata`,
  // which keeps holding whatever those other domains already put there.
  oldVersion     Int?
  newVersion     Int?
  source         String? // "AI" | "HUMAN" | "POLICY"
  reason         String?       @db.Text
  createdAt      DateTime      @default(now())
  user           User?         @relation(fields: [userId], references: [id])
}

model Lead {
  id                  String     @id @default(uuid())
  name                String
  email               String?
  phone               String?
  company             String?
  source              String     @default("Other")
  status              String     @default("new")
  estimatedValue      Float?
  notes               String?
  convertedToClientId String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?
  activities          Activity[]
  convertedClient     Client?    @relation(fields: [convertedToClientId], references: [id])
  notesList           Note[]

  organizationId      String?
  organization        Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@index([source])
  @@index([organizationId])
}

model Client {
  id                             String                                @id @default(uuid())
  name                           String
  email                          String?                               @unique
  phone                          String?
  address                        String?
  website                        String?
  status                         String                                @default("ACTIVE")
  industry                       String?
  notes                          String?
  tier                           ClientTier                            @default(SMB)
  /// Guardian subscription (plan Phase 10). ENTERPRISE by default = every existing feature stays on.
  guardianPlan                   GuardianPlan                          @default(ENTERPRISE) @map("guardian_plan")
  guardianNotificationPreference GuardianClientNotificationPreference?
  guardianPushSubscriptions      GuardianClientPushSubscription[]
  createdAt                      DateTime                              @default(now())
  updatedAt                      DateTime                              @updatedAt
  deletedAt                      DateTime?
  state                          String?
  gstNumber                      String?
  activities                     Activity[]
  amcContracts                   AmcContract[]
  clientUsers                    ClientUser[]
  assets                         Asset[]
  contactPersons                 ContactPerson[]
  domains                        Domain[]
  hostingAssets                  Hosting[]
  invoices                       Invoice[]
  leadsConverted                 Lead[]
  notes_                         Note[]
  projects                       Project[]
  quotes                         Quote[]
  tickets                        Ticket[]
  vpsServers                     VpsServer[]
  installTokens                  GuardianInstallToken[]
  enterpriseSetting              ClientEnterpriseSetting?
  paymentAttempts                PaymentAttempt[]
  manualPaymentSubmissions       ManualPaymentSubmission[]
  collectEnabled                 Boolean                               @default(false) @map("collect_enabled")
  collectApps                    CollectApp[]
  wallet                         ClientWallet?
  bankAccounts                   ClientBankAccount[]

  organizationId                 String?
  organization                   Organization?                         @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model ContactPerson {
  id        String   @id @default(uuid())
  clientId  String
  name      String
  email     String
  phone     String?
  role      String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Note {
  id        String   @id @default(uuid())
  content   String
  leadId    String?
  clientId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client?  @relation(fields: [clientId], references: [id])
  lead      Lead?    @relation(fields: [leadId], references: [id])
}

model Activity {
  id          String   @id @default(uuid())
  type        String
  description String
  leadId      String?
  clientId    String?
  createdAt   DateTime @default(now())
  client      Client?  @relation(fields: [clientId], references: [id])
  lead        Lead?    @relation(fields: [leadId], references: [id])
}

model Domain {
  id         String    @id @default(uuid())
  name       String
  registrar  String?
  expiryDate DateTime?
  clientId   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  client     Client    @relation(fields: [clientId], references: [id])
}

model Hosting {
  id         String    @id @default(uuid())
  provider   String
  plan       String?
  expiryDate DateTime?
  clientId   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  client     Client    @relation(fields: [clientId], references: [id])
}

model VpsServer {
  id        String   @id @default(uuid())
  name      String
  ipAddress String?
  provider  String
  specs     Json?
  clientId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client?  @relation(fields: [clientId], references: [id])
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  clientId    String
  deletedAt   DateTime?
  budget      Decimal?      @db.Decimal(12, 2)
  startDate   DateTime?
  endDate     DateTime?
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  bugReports  BugReport[]
  invoices    Invoice[]
  milestones  Milestone[]
  client      Client        @relation(fields: [clientId], references: [id])
  tasks       Task[]
  testCases   TestCase[]
  tickets     Ticket[]
  attachments Attachment[]
  key                  String?              @unique @map("key")
  githubRepo           String?              @map("github_repo")
  githubRepoId         String?              @map("github_repo_id")
  githubInstallationId String?              @map("github_installation_id")
  githubDefaultBranch  String?              @default("main") @map("github_default_branch")

  taskCounter  ProjectTaskCounter?
  releaseNotes ProjectReleaseNote[]

  organizationId       String?
  organization         Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model ProjectTaskCounter {
  projectId  String  @id @map("project_id")
  lastNumber Int     @default(0) @map("last_number")
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_task_counters")
}

model Milestone {
  id          String    @id @default(uuid())
  name        String
  description String?
  dueDate     DateTime?
  projectId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]
}

model Task {
  id                  String           @id @default(uuid())
  title               String
  description         String?
  status              TaskStatus       @default(TODO)
  priority            Priority         @default(MEDIUM)
  dueDate             DateTime?
  projectId           String
  milestoneId         String?
  amcContractId       String?
  quoteLineItemId     String?
  isBillable          Boolean          @default(false)
  hourlyRate          Decimal?         @db.Decimal(10, 2)
  totalTimeLogged     Float            @default(0)
  totalBillableAmount Decimal?         @db.Decimal(10, 2)
  deletedAt           DateTime?
  ticketId            String?
  estimatedHours      Float?
  parentId            String?
  parent              Task?            @relation("SubTasks", fields: [parentId], references: [id])
  subtasks            Task[]           @relation("SubTasks")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  attachments         Attachment[]
  comments            Comment[]
  amcContract         AmcContract?     @relation(fields: [amcContractId], references: [id])
  milestone           Milestone?       @relation(fields: [milestoneId], references: [id])
  project             Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignments         TaskAssignment[]
  timeLogs            TimeLog[]
  taskCode            String?           @unique @map("task_code")
  githubBranch        String?           @map("github_branch")
  pullRequests        TaskPullRequest[]

  organizationId      String?
  organization        Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([projectId, taskCode])
  @@index([organizationId])
}

model TaskPullRequest {
  id              String    @id @default(uuid())
  taskId          String    @map("task_id")
  prNumber        Int       @map("pr_number")
  prTitle         String    @map("pr_title")
  prUrl           String    @map("pr_url")
  repoFullName    String    @map("repo_full_name")
  repoId          String    @map("repo_id")
  headBranch      String    @map("head_branch")
  baseBranch      String    @map("base_branch")
  status          String    @default("OPEN") @map("status")
  isMerged        Boolean   @default(false) @map("is_merged")
  mergedAt        DateTime? @map("merged_at")
  authorLogin     String?   @map("author_login")
  authorAvatarUrl String?   @map("author_avatar_url")
  ciStatus        String?   @default("PENDING") @map("ci_status")
  reviewStatus    String?   @default("PENDING") @map("review_status")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, repoFullName, prNumber])
  @@index([repoFullName, prNumber])
  @@map("task_pull_requests")
}

model TaskAssignment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model TimeLog {
  id            String        @id @default(uuid())
  hours         Float
  description   String?
  date          DateTime      @default(now())
  taskId        String
  userId        String
  invoiceId     String?
  amcContractId String?
  isBilled      Boolean       @default(false)
  isBillable    Boolean       @default(false)
  billedAt      DateTime?
  hourlyRate    Decimal?      @db.Decimal(10, 2)
  amount        Decimal?      @db.Decimal(10, 2)
  source        TimeLogSource @default(MANUAL)
  createdAt     DateTime      @default(now())
  amcContract   AmcContract?  @relation(fields: [amcContractId], references: [id])
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id])
  task          Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id])
}

model Comment {
  id           String      @id @default(uuid())
  content      String
  isInternal   Boolean     @default(false)
  taskId       String?
  ticketId     String?
  userId       String?
  clientUserId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  task         Task?       @relation(fields: [taskId], references: [id])
  ticket       Ticket?     @relation(fields: [ticketId], references: [id])
  user         User?       @relation(fields: [userId], references: [id])
  clientUser   ClientUser? @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
}

model Ticket {
  id            String       @id @default(uuid())
  title         String
  description   String?
  status        TicketStatus @default(OPEN)
  priority      Priority     @default(MEDIUM)
  category      String
  clientId      String
  projectId     String?
  assignedToId  String?
  slaDeadline   DateTime
  resolvedAt    DateTime?
  closedAt      DateTime?
  deletedAt     DateTime?
  amcContractId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  attachments   Attachment[]
  comments      Comment[]
  amcContract   AmcContract? @relation(fields: [amcContractId], references: [id])
  assignedTo    User?        @relation(fields: [assignedToId], references: [id])
  client        Client       @relation(fields: [clientId], references: [id])
  project       Project?     @relation(fields: [projectId], references: [id])

  organizationId String?
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model BugReport {
  id               String    @id @default(uuid())
  bugId            String?   @unique
  module           String?
  feature          String?
  title            String
  description      String?
  stepsToReproduce String?
  expectedResult   String?
  actualResult     String?
  severity         Priority
  status           String    @default("OPEN")
  projectId        String
  assignedToId     String?
  testCaseId       String?
  createdAt        DateTime  @default(now())
  assignedTo       User?     @relation("AssignedBugs", fields: [assignedToId], references: [id])
  project          Project   @relation(fields: [projectId], references: [id])
  testCase         TestCase? @relation(fields: [testCaseId], references: [id])
}

model TestCase {
  id             String      @id @default(uuid())
  testId         String?     @unique
  module         String?
  screenFeature  String?
  scenario       String?
  steps          String
  expectedResult String
  status         String
  remarks        String?
  createdAt      DateTime    @default(now())
  description    String?
  lastRunAt      DateTime?
  projectId      String
  title          String
  bugReports     BugReport[]
  project        Project     @relation(fields: [projectId], references: [id])
}

model AmcContract {
  id               String            @id @default(uuid())
  contractNumber   String            @unique
  startDate        DateTime
  endDate          DateTime
  totalHours       Int
  usedHours        Float             @default(0)
  hourlyRate       Float
  terms            String?
  status           String            @default("ACTIVE")
  autoRenew        Boolean           @default(false)
  discount         Float             @default(0)
  deletedAt        DateTime?
  clientId         String
  remainingHours   Float             @default(0)
  monthlyValue     Decimal?          @db.Decimal(10, 2)
  annualValue      Decimal?          @db.Decimal(10, 2)
  billingCycle     BillingCycle      @default(MONTHLY)
  billingDay       Int               @default(1)
  nextBillingDate  DateTime?
  alertAt80Percent Boolean           @default(false)
  alertAtExpiry    Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  hourLogs         AmcHourLog[]
  weeklyReports    AmcWeeklyReport[]
  tasks            Task[]
  tickets          Ticket[]
  timeLogs         TimeLog[]
  quoteId          String?           @unique
  quote            Quote?            @relation(fields: [quoteId], references: [id])
  invoices         Invoice[]
  // Which Assets (VPS/hosting/etc.) this contract actually covers — previously an AMC contract
  // only linked to a Client, with no way to say "this contract covers these specific assets."
  assets           Asset[]           @relation("AmcContractAssets")

  organizationId   String?
  organization     Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model AmcHourLog {
  id             String      @id @default(uuid())
  contractId     String
  loggedById     String
  hours          Float
  description    String
  linkedTicketId String?
  linkedTaskId   String?
  loggedAt       DateTime    @default(now())
  createdAt      DateTime    @default(now())
  contract       AmcContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  loggedBy       User        @relation(fields: [loggedById], references: [id])
}

model Quote {
  id                 String          @id @default(uuid())
  clientId           String
  title              String
  description        String?
  totalAmount        Float           @default(0)
  status             String          @default("DRAFT")
  validUntil         DateTime?
  deletedAt          DateTime?
  quoteNumber        String          @unique
  subTotal           Float           @default(0)
  discountAmount     Float           @default(0)
  discountPercent    Float           @default(0)
  gstAmount          Float           @default(0)
  grandTotal         Float           @default(0)
  milestoneSchedule  Json?
  scopeOfWork        String?
  exclusions         String?
  thirdPartyExpenses String?
  termsConditions    String?
  clientApproval     Json?
  sentAt             DateTime?
  sentById           String?
  acceptedAt         DateTime?
  rejectedAt         DateTime?
  rejectionReason    String?
  gstRate            Float           @default(18)
  quoteType          String          @default("PROJECT")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  invoices           Invoice[]
  client             Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sentBy             User?           @relation("SentBy", fields: [sentById], references: [id])
  lineItems          QuoteLineItem[]
  amcContract        AmcContract?
  asset              Asset?

  organizationId     String?
  organization       Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model QuoteLineItem {
  id              String          @id @default(uuid())
  quoteId         String
  serviceId       String?
  itemType        LineItemType    @default(SERVICE)
  description     String
  longDescription String?
  quantity        Int
  unit            String          @default("Project")
  unitPrice       Float
  discountAmount  Float           @default(0)
  discountPercent Float           @default(0)
  amount          Float
  hsnCode         String?
  gstRate         Float           @default(18)
  gstAmount       Float           @default(0)
  sortOrder       Int             @default(0)
  isOptional      Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  quote           Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
