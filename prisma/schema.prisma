  enrollmentDate  DateTime  @default(now()) @map("enrollment_date")
  completionDate  DateTime? @map("completion_date")
  overallProgress Float     @default(0) @map("overall_progress") // 0-100
  currentLevel    Int       @default(1) @map("current_level")
  totalXpEarned   Int       @default(0) @map("total_xp_earned")
  placementStatus String    @default("not_ready") @map("placement_status") // "not_ready", "interview_ready", "placed", "higher_studies"
  placedAt        DateTime? @map("placed_at")
  placedCompany   String?   @map("placed_company")
  placedPackage   Int?      @map("placed_package") // cents
  status          String    @default("active") // "active", "pending" (join-code approval queue), "dropped", "completed", "transferred"

  batch   LaunchpadBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student LaunchpadStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([batchId, studentId])
  @@map("launchpad_batch_enrollments")
}

model LaunchpadPartnerCurriculum {
