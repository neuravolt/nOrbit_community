  // HR review of a flagged (proxy/mismatch) biometric punch -- null until an HR admin acts on it.
  hrReviewStatus String? // APPROVED | DENIED
  hrReviewedById String?
  hrReviewedBy   User?     @relation("AttendanceReviewedBy", fields: [hrReviewedById], references: [id], onDelete: SetNull)
  hrReviewedAt   DateTime?
  hrReviewNote   String?

  @@unique([employeeId, date])
}

model LeaveRequest {
  id             String            @id @default(uuid())
