model LaunchpadTrustScore {
  id             String   @id @default(cuid())
  studentId      String   @map("student_id")
  // Phase F1 (Roadmap Runtime Verification Architecture): NOT-NULL sentinel default, not a
  // nullable column — Postgres composite-unique semantics treat NULL as distinct-per-row, which
  // would silently defeat @@unique below. "_overall" is the pre-existing aggregate score every
  // caller before this phase already computed and upserted; both existing callers keep writing
  // to that exact row unchanged. A real technologySlug (e.g. "express") is a genuine
  // per-technology score, added by Phase F2.
  technologySlug String   @default("_overall") @map("technology_slug")
  score          Float
  consistency    Float
  onTimeRate     Float    @map("on_time_rate")
  clientRating   Float    @map("client_rating")
  discipline     Float
  peerRating     Float    @map("peer_rating")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([studentId, technologySlug])
  @@map("launchpad_trust_scores")
}

// Phase F3: genuinely new metric, never a rename of points/XP — derived from real verification
// evidence quality (finalScore, understanding-check performance, dispute outcomes), distinct
// from Trust Score's reliability/consistency framing. Always technology-scoped — no "_overall"
// sentinel, since "how skilled" is meaningless without a technology to be skilled AT. No row at
// all for a (student, technology) pair with zero verified submissions — never a fabricated 0.
model LaunchpadSkillScore {
  id             String   @id @default(cuid())
  studentId      String   @map("student_id")
  technologySlug String   @map("technology_slug")
  score          Float
  evidenceCount  Int      @default(0) @map("evidence_count")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([studentId, technologySlug])
  @@map("launchpad_skill_scores")
}

