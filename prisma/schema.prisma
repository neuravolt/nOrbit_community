// ═══════════════════════════════════════════════════════════════
// ISSUE #18: Dispute Resolution System
// ═══════════════════════════════════════════════════════════════

model LaunchpadDispute {
  id                     String   @id @default(cuid())
  studentId              String   @map("student_id")
  type                   String // "TASK_REJECTION", "PAYMENT_DISPUTE", "MENTOR_BIAS", "PEER_CONFLICT", "PLATFORM_FEE"
  subject                String
  description            String   @db.Text
  relatedTaskId          String?  @map("related_task_id")
  // Phase D4 (Roadmap Runtime Verification Architecture — Dispute Integration): loose reference
  // to the PeerReviewAssignment this PEER_CONFLICT dispute contests, same no-enforced-FK style
  // every other loose reference in this schema uses. Null for every other dispute type — this
  // system stays generic, not duplicated for peer-review specifically.
  peerReviewAssignmentId String?  @map("peer_review_assignment_id")
  status                 String   @default("OPEN") // "OPEN", "UNDER_REVIEW", "RESOLVED", "ESCALATED", "APPEALED"
  assignedTo             String?  @map("assigned_to")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  evidence    LaunchpadDisputeEvidence[]
  resolutions LaunchpadDisputeResolution[]
  appeals     LaunchpadDisputeAppeal[]

  @@map("launchpad_disputes")
}

model LaunchpadDisputeEvidence {
  id          String   @id @default(cuid())
  disputeId   String   @map("dispute_id")
  type        String // "SUBMISSION", "MESSAGE", "TIMESTAMP", "SCREENSHOT", "SYSTEM_LOG"
  title       String
  url         String?
  content     String?  @db.Text
  submittedBy String   @map("submitted_by")
  createdAt   DateTime @default(now()) @map("created_at")

  dispute LaunchpadDispute @relation(fields: [disputeId], references: [id])

  @@map("launchpad_dispute_evidence")
}

model LaunchpadDisputeResolution {
  id          String   @id @default(cuid())
  disputeId   String   @map("dispute_id")
  decision    String // "STUDENT_FAVOR", "COMPANY_FAVOR", "SPLIT_RESOLUTION"
  explanation String   @db.Text
  actionTaken String   @map("action_taken") @db.Text
  resolvedBy  String   @map("resolved_by")
  createdAt   DateTime @default(now()) @map("created_at")

  dispute LaunchpadDispute @relation(fields: [disputeId], references: [id])

  @@map("launchpad_dispute_resolutions")
}

model LaunchpadDisputeAppeal {
  id         String    @id @default(cuid())
  disputeId  String    @map("dispute_id")
  reason     String    @db.Text
  status     String    @default("PENDING") // "PENDING", "ACCEPTED", "DENIED"
  reviewedBy String?   @map("reviewed_by")
  reviewedAt DateTime? @map("reviewed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  dispute LaunchpadDispute @relation(fields: [disputeId], references: [id])

  @@map("launchpad_dispute_appeals")
}

