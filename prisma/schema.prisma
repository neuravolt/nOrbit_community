// ─── Compensation & Payroll ────────────────────────────────────────────────

// Phase 1, Slice 1 of the Enterprise Payroll Engine plan: versioned, append-only
// replacement for the flat OrganizationSettings payroll-config block. A payroll
// run's snapshot must read from a specific version here, never from the live
// "current" row, so historical runs stay reproducible after the config changes.
model PayrollConfigVersion {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  version        Int          @default(1)
  isActive       Boolean      @default(true)

  // PF / EPF (EPF Act 1952)
  pfEmployeeRate            Float   @default(0.12)
  pfEmployerRate            Float   @default(0.12)
  pfWageCeiling             Float   @default(15000)
  pfApplyWageCap            Boolean @default(true)
  pfEnabled                 Boolean @default(true)
  highPackageBasicThreshold Float   @default(999999)
  highPackagePfOptional     Boolean @default(false)

  // ESI (ESI Act 1948)
  esiEmployeeRate Float   @default(0.0075)
  esiEmployerRate Float   @default(0.0325)
  esiGrossCeiling Float   @default(21000)
  esiEnabled      Boolean @default(true)

  // Professional Tax — state-specific slabs, JSON-encoded
  ptState     String  @default("Karnataka")
  ptSlabsJson String  @default("[{\"upTo\":14999,\"amount\":0},{\"upTo\":19999,\"amount\":150},{\"upTo\":9999999,\"amount\":200}]")
  ptEnabled   Boolean @default(true)

  // LWP / salary-days calculation base
  lwpCalculationBase String @default("CALENDAR")

  // Default conveyance allowance per employment type (INR/month)
  defaultConveyanceEmployee Float @default(1600)
  defaultConveyanceIntern   Float @default(0)
  defaultConveyanceContract Float @default(0)

  // Tax regime + employment-type defaults
  defaultTaxRegime           String @default("NEW")
  employmentTypeDefaultsJson String @default("{\"EMPLOYEE\":{\"pfApplicable\":true,\"esiApplicable\":true},\"PAID_INTERN\":{\"pfApplicable\":false,\"esiApplicable\":false,\"ptOverride\":0},\"CONTRACT\":{\"pfApplicable\":false,\"esiApplicable\":false,\"tdsRate\":0.10},\"UNPAID_INTERN\":{\"pfApplicable\":false,\"esiApplicable\":false,\"ptOverride\":0,\"skipPayroll\":true}}")

  // Versioning window — the previous active row's effectiveTo is set when a new
  // version is created, so exactly one row per org has effectiveTo: null at a time.
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  // Audit metadata — changeReason is required by the service layer on every write.
  createdBy    String
  createdAt    DateTime @default(now())
  changeReason String

  auditLogs PayrollConfigAuditLog[]

  @@unique([organizationId, version])
  @@index([organizationId, isActive])
  @@index([organizationId, effectiveFrom, effectiveTo])
}

// Append-only by construction — see PrismaService's $use guard, which rejects
// any update/delete against this model at the client level.
model PayrollConfigAuditLog {
  id              String               @id @default(uuid())
  organizationId  String
  configVersionId String
  configVersion   PayrollConfigVersion @relation(fields: [configVersionId], references: [id], onDelete: Cascade)

  fieldName     String
  oldValue      String?
  newValue      String
  changedBy     String
  changedAt     DateTime @default(now())
  reason        String
  effectiveFrom DateTime

  @@index([organizationId, changedAt])
  @@index([configVersionId])
}

// Shared audit trail for every mutable payroll entity introduced below
// (components, holiday calendars/holidays/assignments, working week, tax
// config, adjustments, employee overrides). Mirrors PayrollConfigAuditLog's
// one-row-per-changed-field shape and its append-only enforcement (see
// PrismaService's $extends guard) rather than inventing a second pattern —
// a single shared table with an entityType discriminator instead of six
// near-identical per-entity audit tables.
enum PayrollAuditEntityType {
  SALARY_COMPONENT
  EMPLOYEE_SALARY_COMPONENT
  HOLIDAY_CALENDAR
  HOLIDAY
  HOLIDAY_ASSIGNMENT
  WORKING_WEEK
  TAX_REGIME_CONFIG
  PAYROLL_ADJUSTMENT
  EMPLOYEE_OVERRIDE
}

enum PayrollAuditAction {
  CREATE
  UPDATE
  DEACTIVATE
  DELETE
  ASSIGN
  APPROVE
  REJECT
}

model PayrollAuditLog {
  id             String                 @id @default(uuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     PayrollAuditEntityType
  entityId       String
  action         PayrollAuditAction

  fieldName String? // null for a wholesale CREATE/DEACTIVATE/ASSIGN/APPROVE/REJECT with no single changed field
  oldValue  String?
  newValue  String?

  actorId   String
  reason    String?
  createdAt DateTime @default(now())

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
}

// ─── Enterprise Payroll Engine (additive) ───────────────────────────────────
// Everything below is new, dynamic, org-configurable payroll infrastructure
// used by the new POST .../calculate → approve → finalize → lock workflow.
// It is deliberately additive: EmployeeSalary, Payslip, and the legacy
// synchronous POST .../process endpoint are untouched and remain fully
// functional (Section 28 backward-compatibility requirement). Migrating
// existing employees from the legacy fixed EmployeeSalary fields onto the new
// SalaryComponent system is a data-migration decision for later, not made
// here — see the implementation report for why.

enum SalaryComponentType {
  EARNING
  DEDUCTION
}

enum SalaryComponentCalcType {
  FIXED
  PERCENTAGE_OF_BASIC
  PERCENTAGE_OF_GROSS
  PERCENTAGE_OF_CTC
  PER_DAY
  PER_HOUR
  TARGET_BASED
  RATING_BASED
  MANUAL
  FORMULA
}

enum SalaryComponentFrequency {
  MONTHLY
  ANNUAL
  ONE_TIME
  VARIABLE
}

// A component definition — the *rule*, not a per-employee amount. Global
// (organizationId: null) components are available to every org; org-scoped
// components override/extend that for a specific org.
model SalaryComponent {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  code     String // e.g. "PERF_BONUS" — unique per org (or globally when organizationId is null)
  name     String
  type     SalaryComponentType
  isActive Boolean             @default(true)

  calcType    SalaryComponentCalcType @default(FIXED)
  calcBase    String? // for PERCENTAGE_*: "basic" | "gross" | "ctc" — informational for other calc types
  fixedAmount Float?
  percentage  Float?
  formula     String? // only read when calcType = FORMULA; validated via PayrollFormulaEngine before save

  frequency SalaryComponentFrequency @default(MONTHLY)

  pfApplicable  Boolean @default(false)
  esiApplicable Boolean @default(false)
  ptApplicable  Boolean @default(false)
  tdsApplicable Boolean @default(true)
  proratable    Boolean @default(true) // reduced for LWP / partial-month
  lwpAffected   Boolean @default(true)

  displayOrder Int @default(0)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments EmployeeSalaryComponent[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@index([organizationId, type])
}

// Per-employee assignment of a component, with optional per-employee override
// of amount/percentage. Hierarchy: this row -> SalaryComponent -> (statutory
// defaults live inside PayrollConfigVersion for PF/ESI/PT, not here).
model EmployeeSalaryComponent {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  componentId String
  component   SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  amountOverride     Float?
  percentageOverride Float?
  isEligible         Boolean @default(true)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  createdBy String
  createdAt DateTime @default(now())

  @@index([userId, isEligible])
  @@index([componentId])
}

enum PayrollAdjustmentType {
  ARREAR_SALARY
  ARREAR_INCREMENT
  ARREAR_PROMOTION
  CORRECTION
  MANUAL_EARNING
  MANUAL_DEDUCTION
  BONUS
}

enum PayrollAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
}

model PayrollAdjustment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        PayrollAdjustmentType
  amount      Float
  reason      String
  targetMonth Int
  targetYear  Int

  status         PayrollAdjustmentStatus @default(PENDING)
  appliedInRunId String?
  appliedInRun   PayrollRun?             @relation(fields: [appliedInRunId], references: [id])

  createdBy  String
  createdAt  DateTime  @default(now())
  approvedBy String?
  approvedAt DateTime?

  @@index([userId, status])
  @@index([organizationId, targetYear, targetMonth])
}

// Multiple calendars per org (e.g. one per state), employees assignable to
// the right one — deliberately separate from the pre-existing CompanyHoliday
// model (org+branch scoped, used by hr.service.ts's leave-duration helper).
// Consolidating the two is a data-migration decision left for later; both
// remain functional independently for now.
model HolidayCalendar {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  year           Int
  state          String?
  location       String?
  isActive       Boolean      @default(true)

  holidays    Holiday[]
  assignments HolidayCalendarAssignment[]

  createdAt DateTime @default(now())

  @@unique([organizationId, name, year])
  @@index([organizationId, year, isActive])
}

enum HolidayKind {
  PUBLIC
  OPTIONAL
  RESTRICTED
}

model Holiday {
  id         String          @id @default(uuid())
  calendarId String
  calendar   HolidayCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  date       DateTime
  name       String
  type       HolidayKind     @default(PUBLIC)
  isPaid     Boolean         @default(true)
  isOptional Boolean         @default(false)
  isActive   Boolean         @default(true)

  @@unique([calendarId, date])
  @@index([calendarId, date])
}

model HolidayCalendarAssignment {
  id         String          @id @default(uuid())
  calendarId String
  calendar   HolidayCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  @@unique([calendarId, userId])
  @@index([userId])
}

enum DayType {
  FULL_DAY
  HALF_DAY
  OFF
  ALTERNATE
}

model WorkingWeek {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String       @default("Default")

  monday    DayType @default(FULL_DAY)
  tuesday   DayType @default(FULL_DAY)
  wednesday DayType @default(FULL_DAY)
  thursday  DayType @default(FULL_DAY)
  friday    DayType @default(FULL_DAY)
  saturday  DayType @default(OFF)
  sunday    DayType @default(OFF)

  alternateSaturdayRule String @default("NONE") // NONE | 1ST_3RD | 2ND_4TH | ALL

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)

  createdAt DateTime @default(now())

  @@index([organizationId, isActive])
}

model TaxRegimeConfig {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  financialYear  String // "2026-27"
  regimeType     String // "OLD" | "NEW"

  standardDeduction Float @default(75000)
  rebateLimit       Float @default(700000) // taxable income up to which 87A rebate zeroes tax
  rebateAmount      Float @default(25000)
  cessRate          Float @default(0.04)

  isActive      Boolean   @default(true)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  slabs      TaxSlab[]
  surcharges TaxSurchargeSlab[]

  createdBy String
  createdAt DateTime @default(now())

  @@unique([organizationId, financialYear, regimeType])
  @@index([organizationId, financialYear])
}

model TaxSlab {
  id             String          @id @default(uuid())
  regimeConfigId String
  regimeConfig   TaxRegimeConfig @relation(fields: [regimeConfigId], references: [id], onDelete: Cascade)
  incomeFrom     Float
  incomeTo       Float? // null = no upper bound
  taxRate        Float // e.g. 0.20 for 20%

  @@index([regimeConfigId])
}

// Surcharge on TOTAL TAX (not income) above the statutory thresholds — kept
// separate from TaxSlab since it applies as a percentage of tax payable, and
// marginal relief (Section 10) is computed from this table at calculation
// time rather than stored.
model TaxSurchargeSlab {
  id             String          @id @default(uuid())
  regimeConfigId String
  regimeConfig   TaxRegimeConfig @relation(fields: [regimeConfigId], references: [id], onDelete: Cascade)
  incomeFrom     Float
  incomeTo       Float?
  surchargeRate  Float

  @@index([regimeConfigId])
}

model TaxExemption {
  id             String @id @default(uuid())
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  financialYear  String
  section        String // "80C" | "80D" | "80G" | "HRA" | ...
  declaredAmount Float
  approvedAmount Float?
  status         String @default("DECLARED") // DECLARED | VERIFIED | REJECTED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, financialYear])
}

model OvertimeConfig {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isEnabled      Boolean      @default(false)

  normalMultiplier  Float   @default(1.5)
  weekendMultiplier Float   @default(2.0)
  holidayMultiplier Float   @default(2.0)
  requiresApproval  Boolean @default(true)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)

  createdAt DateTime @default(now())

  @@index([organizationId, isActive])
}

enum OvertimeEntryStatus {
  PENDING
  APPROVED
  REJECTED
}

model OvertimeEntry {
  id      String   @id @default(uuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date    DateTime
  hours   Float
  dayKind String // "NORMAL" | "WEEKEND" | "HOLIDAY"

  status     OvertimeEntryStatus @default(PENDING)
  approvedBy String?
  approvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, date])
}

// One immutable snapshot per payroll run, captured at calculation time. Every
// number needed to reproduce the run byte-for-byte lives here — a payroll run
// must never be recomputed by re-reading live config after this is written.
// Bug caught by the real-database dry-run (mocks never enforce unique
// constraints, so the test suite missed this): payrollRunId was originally
// @unique, but calculate() is explicitly allowed to run again from DRAFT or
// CALCULATED (recalculation) and creates a brand-new snapshot every time —
// the immutability guarantee is "never update/delete a snapshot", not "only
// one snapshot per run ever". A second create() with a unique constraint on
// payrollRunId would have failed with a real Postgres constraint violation
// the moment anyone recalculated a real run. Fixed to a plain index: each
// run accumulates one snapshot per calculate() call, and each Payslip already
// points at the exact snapshot it was computed from via its own snapshotId
// — that per-payslip reference was always precise; only "the one snapshot
// for a run" lookups needed to become "the latest snapshot for a run".
model PayrollRunSnapshot {
  id           String     @id @default(uuid())
  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  // Denormalized queryable fields (fast WHERE/GROUP BY without parsing JSON)
  pfEmployeeRate     Float
  pfEmployerRate     Float
  pfWageCeiling      Float
  esiEmployeeRate    Float
  esiEmployerRate    Float
  esiGrossCeiling    Float
  ptState            String
  lwpCalculationBase String
  taxRegime          String

  // Full JSON — source of truth for calculation replay
  payrollConfigJson          Json
  salaryComponentsJson       Json
  employeeSalarySnapshotJson Json
  taxConfigJson              Json?
  holidayCalendarJson        Json?
  workingWeekJson            Json?
  overtimeConfigJson         Json?
  adjustmentsJson            Json?

  calculationVersion String // engine semver, for replay debugging
  effectiveDate      DateTime // payroll month start
  capturedAt         DateTime @default(now())
  capturedBy         String

  isLocked Boolean @default(false)

  @@index([payrollRunId])
  @@index([payrollRunId, capturedAt])
}

model PayrollRun {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  month          Int
  year           Int
  status         PayrollRunStatus @default(DRAFT)
  processedAt    DateTime?
  payslips       Payslip[]
  createdAt      DateTime         @default(now())

  // Enterprise Payroll Engine workflow additions — all nullable/optional so
  // the legacy synchronous POST .../process path (which never touches these)
  // continues to insert/update PayrollRun rows exactly as before.
  createdBy    String?
  snapshots    PayrollRunSnapshot[]
  adjustments  PayrollAdjustment[]
  calculatedAt DateTime?
  reviewedAt   DateTime?
  approvedAt   DateTime?
  approvedBy   String?
  finalizedAt  DateTime?
  finalizedBy  String?
  lockedAt     DateTime?
  lockedBy     String?

  @@index([organizationId])
}

model Payslip {
  id           String     @id @default(uuid())
  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ─── Earnings ─────────────────────────────────────────────────────────────
  basic                Float
  hra                  Float @default(0)
  conveyanceAllowance  Float @default(0)
  specialAllowance     Float @default(0)
  performanceIncentive Float @default(0)
  daAllowance          Float @default(0)
  otherAllowance       Float @default(0)
  allowances           Float @default(0) // Total of all allowances (backward compat)
  grossPay             Float @default(0) // basic + all allowances before deductions

  // ─── Deductions (itemized) ────────────────────────────────────────────────
  pfEmployee      Float @default(0) // 12% of basic (capped at wage ceiling)
  pfEmployer      Float @default(0) // Employer's 12% — shown, not deducted from employee
  esiEmployee     Float @default(0) // 0.75% of gross
  esiEmployer     Float @default(0) // 3.25% of gross — shown informational
  professionalTax Float @default(0) // State PT slab
  tds             Float @default(0) // TDS for the month
  gisDeduction    Float @default(0) // Group Insurance
  npsEmployee     Float @default(0) // NPS employee contribution
  lwpDeduction    Float @default(0) // Loss of Pay deduction
  otherDeductions Float @default(0)
  deductions      Float @default(0) // Total deductions (backward compat)

  // ─── LWP / Attendance ─────────────────────────────────────────────────────
  workingDays Int   @default(0) // Calendar working days in month
  presentDays Float @default(0) // Days employee was present (PRESENT+LATE+0.5*HALF_DAY)
  lwpDays     Float @default(0) // Loss of Pay days (ABSENT or UNPAID leave)

  netPay    Float
  pdfFileId String?
  createdAt DateTime @default(now())

  // ─── Enterprise Payroll Engine additions (additive, all optional/defaulted
  // so the legacy synchronous POST .../process upsert — which never sets
  // these — continues to work unchanged) ─────────────────────────────────────
  componentBreakdownJson Json? // dynamic SalaryComponent earnings/deductions, code -> amount
  overtimePay            Float   @default(0)
  arrearsAmount          Float   @default(0)
  employerCost           Float   @default(0)
  calculationVersion     String?
  snapshotId             String? // PayrollRunSnapshot.id this payslip was computed from, when applicable

  @@unique([payrollRunId, userId])
  @@index([payrollRunId])
  @@index([userId])
}

model EmployeeSalary {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime
  ctc           Float

  // ─── Earnings Components ──────────────────────────────────────────────────
  basicSalary          Float
  hra                  Float  @default(0)
  conveyanceAllowance  Float  @default(1600) // Standard: ₹1,600/month tax-exempt
  specialAllowance     Float  @default(0)
  performanceIncentive Float  @default(0)
  daAllowance          Float  @default(0) // Dearness Allowance
  otherAllowance       Float  @default(0)
  allowance            Float? // Legacy field preserved for zero data loss

  // ─── Statutory Deductions (PF / EPF) ─────────────────────────────────────
  // EPF Act 1952: Employee 12% of Basic, Employer 12% (3.67% EPF + 8.33% EPS)
  pfApplicable         Boolean @default(false)
  pfWageCeiling        Float   @default(15000) // Statutory cap: ₹15,000 basic
  voluntaryPfPercent   Float   @default(0) // Extra voluntary PF % on basic (0-88%)
  employerPfApplicable Boolean @default(true) // Employer 12% shown on payslip

  // ─── Statutory Deductions (ESI) ──────────────────────────────────────────
  // ESI Act 1948: Applicable only if gross ≤ ₹21,000/month
  esiApplicable   Boolean @default(false)
  esiGrossCeiling Float   @default(21000) // ESI eligibility threshold

  // ─── Other Deductions ─────────────────────────────────────────────────────
  // PT is state-specific: Karnataka slab (0/150/200) auto-computed unless overridden
  professionalTaxOverride Float? // null = auto-compute from state slab; non-null = manual override
  professionalTax         Float? // Legacy field preserved for zero data loss
  tds                     Float  @default(0) // Monthly TDS amount
  gisDeduction            Float  @default(0) // Group Insurance Scheme
  npsEmployee             Float  @default(0) // NPS employee contribution
  otherDeductions         Float  @default(0) // Miscellaneous deductions

  // ─── Classification & Config ──────────────────────────────────────────────
  // Controls auto-rule logic for the payroll engine
  // "EMPLOYEE" | "PAID_INTERN" | "CONTRACT" | "UNPAID_INTERN"
  employmentCategory String  @default("EMPLOYEE") // mirrors User.employmentType at time of salary creation
  taxRegime          String  @default("NEW") // "NEW" | "OLD" — Income Tax regime
  pfNumber           String? // PF Account Number (UAN)
  esiNumber          String? // ESI IP number

  salaryCycle String       @default("Monthly") @map("salary_cycle")
  paymentMode String       @default("Bank Transfer") @map("payment_mode")
  status      SalaryStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())

  @@index([userId])
}

// ─── Notifications Subsystem Logs ───────────────────────────────────────────

model HrmsNotification {
  id             String                   @id @default(uuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id])
  title          String
  content        String
  channel        NotificationChannel      @default(EMAIL)
  preferences    NotificationPreference[]
  logs           NotificationLog[]
  createdAt      DateTime                 @default(now())

  @@index([organizationId])
}

model NotificationPreference {
  id             String              @id @default(uuid())
  notificationId String
  notification   HrmsNotification    @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  enabled        Boolean             @default(true)

  @@index([notificationId])
  @@index([userId])
}

model NotificationLog {
  id             String           @id @default(uuid())
  notificationId String
  notification   HrmsNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentStatus     String // SENT, FAILED
  errorMessage   String?
  sentAt         DateTime         @default(now())

  @@index([notificationId])
  @@index([userId])
}

// ==========================================
// ENTERPRISE BIOMETRIC IDENTITY PLATFORM MODELS
// ==========================================

enum BiometricType {
  FACE
  FINGERPRINT
  IRIS
  PASSKEY
  AADHAAR_EKYC
}

enum BiometricProfileStatus {
  ACTIVE
  DISABLED
  PENDING_RE_ENROLLMENT
  REVOKED
}

enum BiometricAuditAction {
  ENROLLMENT
  VERIFICATION
  RE_ENROLLMENT
  ROLLBACK
  DELETION
  CONSENT_GRANTED
  CONSENT_REVOKED
}

enum BiometricVerificationStatus {
  VERIFIED
  REJECTED
  FLAGGED
  ERROR
}

model BiometricProfile {
  id             String                 @id @default(uuid())
  employeeId     String                 @unique
  employee       User                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  biometricType  BiometricType          @default(FACE)
  status         BiometricProfileStatus @default(ACTIVE)
  enrolledAt     DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  retentionUntil DateTime?
  faceProfile    FaceProfile?

  @@index([employeeId])
  @@index([status])
}

model FaceProfile {
  id                     String           @id @default(uuid())
  biometricProfileId     String           @unique
  biometricProfile       BiometricProfile @relation(fields: [biometricProfileId], references: [id], onDelete: Cascade)
  profilePhotoUrl        String
  embedding              String // Encrypted / Base64-encoded 512D ArcFace Float Array (pgvector compatible)
  embeddingHash          String
  modelVersion           String           @default("face-api-js_face_recognition_v1")
  enrollmentQualityScore Float            @default(0.95)
  referenceHistory       Json? // Array of past 10 embedding versions for rollback
  adaptiveEmaAlpha       Float            @default(0.05)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
}

model BiometricAuditLog {
  id                     String                      @id @default(uuid())
  employeeId             String
  employee               User                        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  biometricType          BiometricType               @default(FACE)
  action                 BiometricAuditAction
  purpose                String // ATTENDANCE, LEAVE_APPROVAL, PAYROLL_ACCESS, PROFILE_CHANGE
  matchScore             Float?
  livenessScore          Float?
  spoofProbability       Float?
  verificationStatus     BiometricVerificationStatus
  failureReason          String?
  capturedMediaUrl       String?
  deviceFingerprint      String?
  ipAddress              String?
  verificationDurationMs Int?
  createdAt              DateTime                    @default(now())

  @@index([employeeId])
  @@index([verificationStatus])
  @@index([createdAt])
}

model ConsentRegistry {
  id            String        @id @default(uuid())
  employeeId    String
  employee      User          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  biometricType BiometricType @default(FACE)
  purpose       String // ATTENDANCE, LEAVE_APPROVAL, PAYROLL_ACCESS, PROFILE_CHANGE
  granted       Boolean       @default(true)
  grantedAt     DateTime      @default(now())
  expiresAt     DateTime
  ipAddress     String?
  userAgent     String?

  @@index([employeeId])
  @@index([purpose])
}

// ─────────────────────────────────────────────────────────────────────────────
// MEETINGS MANAGEMENT MODULE
// ─────────────────────────────────────────────────────────────────────────────

enum MeetingStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Meeting {
  id          String        @id @default(uuid())
  title       String
  meetingDate DateTime
  meetingUrl  String
  pinHash     String
  pin         String?       @map("pin")
  slug        String        @unique
  status      MeetingStatus @default(ACTIVE)
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  createdBy   User?         @relation("UserCreatedMeetings", fields: [createdById], references: [id])

  @@index([meetingDate])
  @@index([status])
  @@index([slug])
}

/// Per-user Guardian notification settings (plan Phase 3). No row = defaults (everything on).
model GuardianNotificationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  emailEnabled    Boolean  @default(true) @map("email_enabled")
  inAppEnabled    Boolean  @default(true) @map("in_app_enabled")
  /// Lowest severity that notifies: INFO | WARNING | CRITICAL | EMERGENCY
  minSeverity     String   @default("INFO") @map("min_severity")
  /// Categories switched off: REMINDER | ESCALATION | ATTACK_SURFACE | DIGEST
  mutedCategories String[] @default([]) @map("muted_categories")
  telegramChatId  String?  @map("telegram_chat_id")
  pushEnabled     Boolean  @default(true) @map("push_enabled")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("guardian_notification_preferences")
}

/// Browser Web Push subscriptions for Guardian alerts (VAPID, no third-party service).
model GuardianPushSubscription {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("guardian_push_subscriptions")
}

/// A client's own choice of Guardian alert channels (client portal). No row = email on, others off.
model GuardianClientNotificationPreference {
  id             String   @id @default(cuid())
  clientId       String   @unique @map("client_id")
  emailEnabled   Boolean  @default(true) @map("email_enabled")
  telegramChatId String?  @map("telegram_chat_id")
  pushEnabled    Boolean  @default(true) @map("push_enabled")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("guardian_client_notification_preferences")
}

/// Browser push subscriptions of client-portal users (VAPID).
model GuardianClientPushSubscription {
  id         String    @id @default(cuid())
  clientId   String    @map("client_id")
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("guardian_client_push_subscriptions")
}

// ============================================================================
// NeuraChat — Enterprise Collaboration & Workflow Intelligence Models
// ============================================================================

enum ChatConversationType {
  DIRECT
  GROUP
  CHANNEL
  PROJECT
  INCIDENT
}

enum ChatMessageType {
  TEXT
  CODE_SNIPPET
  ATTACHMENT
  TASK_CARD
  INCIDENT_ALERT
  VOICE_NOTE
  SYSTEM_LOG
}

enum ChatMemberRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

model ChatConversation {
  id             String               @id @default(cuid())
  type           ChatConversationType @default(DIRECT)
  title          String?
  description    String?
  avatarUrl      String?
  isPrivate      Boolean              @default(false)
  
  // Unified Work Graph Entity Links
  entityType     String?              // e.g. "PROJECT", "TASK", "INCIDENT", "CLIENT"
  entityId       String?              // Associated entity ID
  
  createdById    String
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  members        ChatMember[]
  messages       ChatMessage[]
  pinnedMessages ChatPinnedMessage[]

  @@index([type])
  @@index([entityType, entityId])
  @@map("chat_conversations")
}

model ChatMember {
  id             String         @id @default(cuid())
  conversationId String         @map("conversation_id")
  userId         String         @map("user_id")
  role           ChatMemberRole @default(MEMBER)
  lastReadAt     DateTime       @default(now()) @map("last_read_at")
  isMuted        Boolean        @default(false) @map("is_muted")
  joinedAt       DateTime       @default(now()) @map("joined_at")

  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("chat_members")
}

model ChatMessage {
  id              String          @id @default(cuid())
  conversationId  String          @map("conversation_id")
  senderId        String          @map("sender_id")
  
  // Threading
  parentId        String?         @map("parent_id")
  replyCount      Int             @default(0) @map("reply_count")
  
  // Content & Security
  type            ChatMessageType @default(TEXT)
  content         String          @db.Text
  isInternalOnly  Boolean         @default(false) @map("is_internal_only")
  hasRedactedData Boolean         @default(false) @map("has_redacted_data")
  metadata        Json?           // Stores task info, code language, attachments, voice duration, etc.
  
  isEdited        Boolean         @default(false) @map("is_edited")
  isDeleted       Boolean         @default(false) @map("is_deleted")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  conversation    ChatConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User                 @relation(fields: [senderId], references: [id], onDelete: Cascade)
  parent          ChatMessage?         @relation("ThreadReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies         ChatMessage[]        @relation("ThreadReplies")
  receipts        ChatMessageReceipt[]
  reactions       ChatMessageReaction[]
  pinnedIn        ChatPinnedMessage[]

  @@index([conversationId, createdAt])
  @@index([parentId])
  @@map("chat_messages")
}

model ChatMessageReceipt {
  id        String    @id @default(cuid())
  messageId String    @map("message_id")
  userId    String    @map("user_id")
  status    String    @default("DELIVERED") // DELIVERED, READ
  readAt    DateTime? @map("read_at")

  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@map("chat_message_receipts")
}

model ChatMessageReaction {
  id        String   @id @default(cuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  emoji     String

  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@map("chat_message_reactions")
}

model ChatPinnedMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  messageId      String   @map("message_id")
  pinnedById     String   @map("pinned_by_id")
  pinnedAt       DateTime @default(now()) @map("pinned_at")

  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        ChatMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy       User             @relation(fields: [pinnedById], references: [id], onDelete: Cascade)

  @@unique([conversationId, messageId])
  @@map("chat_pinned_messages")
}

