model GuardianMonitor {
  id        String  @id @default(cuid())
  agentId   String  @map("agent_id")
  websiteId String? @map("website_id") // Link to Asset (Website)

  // Real-time metrics (updated every 60s)
  cpuPercent     Decimal? @map("cpu_percent") @db.Decimal(5, 2)
  ramUsedMB      Int?     @map("ram_used_mb")
  ramTotalMB     Int?     @map("ram_total_mb")
  diskUsageGB    Decimal? @map("disk_usage_gb") @db.Decimal(10, 2)
  diskTotalGB    Decimal? @map("disk_total_gb") @db.Decimal(10, 2)
  loadAverage    String?  @map("load_average")
  phpWorkers     Int?     @map("php_workers")
  phpWorkersMax  Int?     @map("php_workers_max")
  requestsPerMin Int?     @map("requests_per_min")
