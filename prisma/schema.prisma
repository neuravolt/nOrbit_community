  id             String   @id @default(uuid())
  templateName   String   @map("template_name")
  recipientEmail String   @map("recipient_email")
  subject        String
  smtpMessageId  String   @map("smtp_message_id")
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  clientId       String?  @map("client_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("sent_emails")
}

model EmailTemplate {
  id          String                 @id @default(uuid())
  name        String                 @unique // e.g., "quote_sent", "invoice_sent"
  subject     String
  description String?
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  versions    EmailTemplateVersion[]

  @@map("email_templates")
}

model EmailTemplateVersion {
  id          String        @id @default(uuid())
  templateId  String        @map("template_id")
  content     String        @db.Text
  version     Int
  isActive    Boolean       @default(false)
  createdById String?       @map("created_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  template    EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("email_template_versions")
}

// ==================== CONFIGURATION TABLES ====================
// Admin-configurable system settings

model LaunchpadConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedBy   String   @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("launchpad_config")
}

model LaunchpadTrack {
  id          String    @id @default(cuid())
  name        String    @unique
  displayName String    @map("display_name")
  description String?   @db.Text
  icon        String? // Emoji or icon name
  color       String? // Hex color
  priority    Int       @default(0)
  isActive    Boolean   @default(true) @map("is_active")
  isDefault   Boolean   @default(false) @map("is_default")
  openDate    DateTime? @map("open_date")
  minSemester Int?      @map("min_semester")
  skills      String[] // Required/preferred skills
  department  String    @default("ENGINEERING")
  roleCode    String    @default("BACKEND_DEV") @map("role_code")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tasks                 LaunchpadTask[]
  students              LaunchpadStudent[]
  modules               LaunchpadTrainingModule[]
  careerRecommendations LaunchpadCareerRecommendation[]
  roleSkills            LaunchpadRoleSkill[]
  primaryProfiles       LaunchpadCareerProfile[]        @relation("PrimaryRole")
  secondaryProfiles     LaunchpadCareerProfile[]        @relation("SecondaryRole")

  @@map("launchpad_roles")
}

model LaunchpadTaskCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  displayName String  @map("display_name")
  description String? @db.Text
  icon        String?
  color       String?
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  tasks LaunchpadTask[]

  @@map("launchpad_task_categories")
}

// ==================== STUDENT TABLES ====================

model LaunchpadStudent {
  id           String  @id @default(cuid())
  email        String  @unique
  phone        String?
  fullName     String  @map("full_name")
  passwordHash String? @map("password_hash")

  // Academic
  college     String
  semester    Int
  branch      String?
  yearOfStudy Int?    @map("year_of_study")

  // Program
  trackId          String?         @map("track_id")
  track            LaunchpadTrack? @relation(fields: [trackId], references: [id])
  secondaryTrackId String?         @map("secondary_track_id")

  level              Int     @default(1)
  totalPoints        Int     @default(0) @map("total_points")
  totalEarnings      Decimal @default(0) @map("total_earnings") @db.Decimal(12, 2)
  peerReviewAccuracy Int     @default(100) @map("peer_review_accuracy")

  // Security
  mustChangePassword    Boolean   @default(false) @map("must_change_password")
  tempPasswordExpiresAt DateTime? @map("temp_password_expires_at")
  lastLoginAt           DateTime? @map("last_login_at")
  failedLoginAttempts   Int       @default(0) @map("failed_login_attempts")
  lockedUntil           DateTime? @map("locked_until")

  // Rejection
  rejectionReason   String?            @map("rejection_reason")
  rejectionCategory RejectionCategory? @map("rejection_category")
  canReapplyAt      DateTime?          @map("can_reapply_at")

  // Streaks
  currentStreak  Int       @default(0) @map("current_streak")
  longestStreak  Int       @default(0) @map("longest_streak")
  lastStreakDate DateTime? @map("last_streak_date")

  // Referral
  referralCode  String? @unique @map("referral_code")
  referredBy    String? @map("referred_by")
  referralCount Int     @default(0) @map("referral_count")

  // Status
  status LaunchpadStudentStatus @default(APPLIED)

  // Onboarding
  onboardingStep      Int     @default(0) @map("onboarding_step")
  onboardingCompleted Boolean @default(false) @map("onboarding_completed")
  trainingProgress    Json?   @map("training_progress") // {moduleId: completed}

  // Profile
  bio          String?  @db.Text
  skills       String[]
  linkedInUrl  String?  @map("linkedin_url")
  githubUrl    String?  @map("github_url")
  portfolioUrl String?  @map("portfolio_url")
  avatarUrl    String?  @map("avatar_url")

  // Activity
  lastActiveAt DateTime? @map("last_active_at")
  loginCount   Int       @default(0) @map("login_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  submissions         LaunchpadSubmission[]
  leads               LaunchpadLead[]
  redemptions         LaunchpadRedemption[]
  badges              LaunchpadBadge[]
  timeLogs            LaunchpadTimeLog[]
  projectAssignments  LaunchpadProjectAssignment[]
  pointTransactions   LaunchpadPointTransaction[]
  notifications       LaunchpadNotification[]
  tokenVersion        Int                           @default(1) @map("token_version")
  refreshTokens       RefreshToken[]
  trainingCompletions LaunchpadTrainingCompletion[]

  assessmentSessions LaunchpadAssessmentSession[]
  evidenceSources    LaunchpadEvidenceSource[]
  userSkills         LaunchpadUserSkill[]
  wallet             LaunchpadWallet?
  walletTransactions LaunchpadWalletTransaction[]
  taskClaims         LaunchpadTaskClaim[]
  taskProgress       LaunchpadStudentTaskProgress[]
  stepSubmissions    LaunchpadTaskStepSubmission[]
  careerProfile      LaunchpadCareerProfile?
  technologyProgress LaunchpadStudentTechnologyProgress[]
  nodeProgress       LaunchpadStudentNodeProgress[]
  batchEnrollments   LaunchpadBatchEnrollment[]

  @@map("launchpad_students")
}

// ==================== TASK & SUBMISSION TABLES ====================

model LaunchpadTask {
  id               String  @id @default(cuid())
  title            String
  description      String? @db.Text
  shortDescription String? @map("short_description")
  evaluationConfig Json?   @map("evaluation_config")
  // Phase A (Roadmap): mirrors LaunchpadRoadmapNode.codingChallenge — {requirements,
  // evaluationCriteria, expectedSkills} — populated only for proofType: 'CODE' tasks, by admin
  // authoring. Null for every other proof type; nothing reads this unless proofType is CODE.
  codingChallenge  Json?   @map("coding_challenge")

  // Categorization
  trackId    String                 @map("track_id")
  track      LaunchpadTrack         @relation(fields: [trackId], references: [id])
  categoryId String?                @map("category_id")
  category   LaunchpadTaskCategory? @relation(fields: [categoryId], references: [id])
  tags       String[]

  // Points & Levels
  basePoints Int  @map("base_points")
  minLevel   Int  @default(1) @map("min_level")
  maxLevel   Int? @map("max_level")
  difficulty Int  @default(1) // 1-5

  // Payment (for paid levels)
  paymentEnabled Boolean  @default(false) @map("payment_enabled")
  paymentAmount  Decimal? @map("payment_amount") @db.Decimal(12, 2)
  paymentType    String?  @map("payment_type") // FIXED, PER_HOUR, COMMISSION

  // Task details
  estimatedHours Float?  @map("estimated_hours")
  deadlineDays   Int?    @map("deadline_days")
  maxSubmissions Int     @default(1) @map("max_submissions")
  allowRevision  Boolean @default(true) @map("allow_revision")
  maxRevisions   Int     @default(2) @map("max_revisions")

  // Proof requirements
  proofType         String  @map("proof_type") // NONE, SCREENSHOT, LINK, FILE, TEXT, CODE, VIDEO, AUDIO, AUTO
  proofInstructions String? @map("proof_instructions") @db.Text
  proofExample      String? @map("proof_example")
  requiredProofs    Int     @default(1) @map("required_proofs")

  // Instructions & Resources
  instructions String? @db.Text
  resources    Json? // [{title, url, type, description}]
  checklist    Json? // [{item, required}]

  // Auto-approval
  autoApprove      Boolean @default(false) @map("auto_approve")
  autoApproveRules Json?   @map("auto_approve_rules") // {minWordCount, requiredFields}

  // Availability
  startDate      DateTime? @map("start_date")
  endDate        DateTime? @map("end_date")
  maxCompletions Int?      @map("max_completions") // Global limit
  studentLimit   Int?      @map("student_limit") // Per student limit

  // Status
  status     String  @default("DRAFT") // DRAFT, ACTIVE, INACTIVE, ARCHIVED
  isFeatured Boolean @default(false) @map("is_featured")

  // Meta
  createdBy String   @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  submissions       LaunchpadSubmission[]
  steps             LaunchpadTaskStep[]
  taskPrerequisites LaunchpadTaskPrerequisite[]    @relation("TaskDependencies")
  prereqTasks       LaunchpadTaskPrerequisite[]    @relation("TaskPrerequisites")
  studentProgress   LaunchpadStudentTaskProgress[]

  @@map("launchpad_tasks")
}

model LaunchpadSubmission {
  id String @id @default(cuid())

  taskId    String           @map("task_id")
  task      LaunchpadTask    @relation(fields: [taskId], references: [id])
  studentId String           @map("student_id")
  student   LaunchpadStudent @relation(fields: [studentId], references: [id])

  // Proofs (multiple types supported)
  proofs Json // [{type, url, text, fileName, uploadedAt}]
  notes  String? @db.Text

  // Review
  status String @default("PENDING")

  qualityScore  Int?     @map("quality_score") // 0-10
  pointsAwarded Int?     @map("points_awarded")
  paymentAmount Decimal? @map("payment_amount") @db.Decimal(12, 2)

  reviewerId       String?   @map("reviewer_id")
  reviewerFeedback String?   @map("reviewer_feedback") @db.Text
  reviewedAt       DateTime? @map("reviewed_at")
  reviewTime       Int?      @map("review_time") // Seconds spent reviewing

  // Revision tracking
  revisionCount        Int     @default(0) @map("revision_count")
  previousSubmissionId String? @map("previous_submission_id")

  // Timeline
  acceptedAt  DateTime? @map("accepted_at")
  submittedAt DateTime  @default(now()) @map("submitted_at")
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("launchpad_submissions")
}

// ==================== LEAD TABLES ====================

model LaunchpadLead {
  id String @id @default(cuid())

  studentId String           @map("student_id")
  student   LaunchpadStudent @relation(fields: [studentId], references: [id])

  // Company
  companyName String  @map("company_name")
  companySize String? @map("company_size") // STARTUP, SME, ENTERPRISE
  industry    String?
  website     String?
  location    String?

  // Contact
  contactName String? @map("contact_name")
  contactRole String? @map("contact_role")
  email       String?
  phone       String?
  linkedInUrl String? @map("linkedin_url")

  // Lead details
  serviceNeed     String?  @map("service_need") @db.Text
  serviceCategory String?  @map("service_category")
  budgetRange     String?  @map("budget_range") // UNDER_10K, 10K_50K, 50K_1L, 1L_PLUS, CUSTOM
  budgetCustom    Decimal? @map("budget_custom") @db.Decimal(12, 2)
  timeline        String? // IMMEDIATE, 1_WEEK, 1_MONTH, 3_MONTHS, FLEXIBLE
  urgency         String? // LOW, MEDIUM, HIGH, CRITICAL

  // Quality (auto + manual)
  autoQualityScore   Int?  @map("auto_quality_score")
  manualQualityScore Int?  @map("manual_quality_score")
  finalQualityScore  Int?  @map("final_quality_score")
  qualityBreakdown   Json? @map("quality_breakdown") // {criteria: score}

  // Status
  status String @default("SUBMITTED")

  // OS Integration
  osLeadId     String? @map("os_lead_id")
  osLeadStatus String? @map("os_lead_status")

  // Deal tracking
  convertedToDeal  Boolean   @default(false) @map("converted_to_deal")
  dealValue        Decimal?  @map("deal_value") @db.Decimal(12, 2)
  dealClosedAt     DateTime? @map("deal_closed_at")
  commissionRate   Decimal?  @default(0.05) @map("commission_rate") @db.Decimal(4, 2)
  commissionPaid   Decimal?  @map("commission_paid") @db.Decimal(12, 2)
  commissionStatus String    @default("PENDING") @map("commission_status")

  // Admin
  assignedAdminId String? @map("assigned_admin_id")
  adminNotes      String? @map("admin_notes") @db.Text

  // Timeline
  firstContactAt DateTime? @map("first_contact_at")
  lastFollowUpAt DateTime? @map("last_follow_up_at")
  nextFollowUpAt DateTime? @map("next_follow_up_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("launchpad_leads")
}

// ==================== QUALITY RULES (ADMIN CONFIGURABLE) ====================

model LaunchpadQualityRule {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Applies to
  appliesTo String @map("applies_to") // LEAD, SUBMISSION, BOTH

  // Criteria
  field    String // Which field to check
  operator String // EQUALS, CONTAINS, GREATER_THAN, REGEX, EXISTS
  value    String? // Comparison value
  points   Int // Points to award/deduct

  // Scoring
  weight   Int @default(1) // For weighted scoring
  maxScore Int @map("max_score")

  // Conditions
  isActive Boolean @default(true) @map("is_active")
  priority Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("launchpad_quality_rules")
}

// ==================== LEVEL & REWARD TABLES ====================

model LaunchpadLevel {
  id          String  @id @default(cuid())
  level       Int     @unique
  name        String
  displayName String  @map("display_name")
  description String? @db.Text

  // Points range
  minPoints Int  @map("min_points")
  maxPoints Int? @map("max_points")

  // Status
  statusType String @map("status_type") // TRAINEE, ASSOCIATE, PAID, INTERN, JOB, FOUNDER

  // Benefits (admin configurable)
  benefits Json? // [{type, description, value, icon}]

  // Visual
  badgeIcon  String? @map("badge_icon")
  badgeColor String? @map("badge_color")
  bannerUrl  String? @map("banner_url")

  // Unlockables
  unlocks Json? // [{type, entityId, description}]

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("launchpad_levels")
}

model LaunchpadReward {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text
  shortDesc   String? @map("short_desc")

  // Categorization
  category    String // DIGITAL, PHYSICAL, EXPERIENCE, CASH, CERTIFICATE, MENTORSHIP, CUSTOM
  subCategory String? @map("sub_category")

  // Cost
  pointsCost Int      @map("points_cost")
  cashValue  Decimal? @map("cash_value") @db.Decimal(12, 2)

  // Requirements
  minLevel      Int     @default(1) @map("min_level")
  maxLevel      Int?    @map("max_level")
  trackId       String? @map("track_id")
  requiresBadge String? @map("requires_badge")

  // Inventory (for physical)
  stockQuantity Int?    @map("stock_quantity")
  totalRedeemed Int     @default(0) @map("total_redeemed")
  isLimited     Boolean @default(false) @map("is_limited")

  // Delivery
  deliveryType   String @default("AUTO") @map("delivery_type") // AUTO, MANUAL, EMAIL, SHIP
  deliveryConfig Json?  @map("delivery_config") // {emailTemplate, shippingRequired}

  // Media
  imageUrl String? @map("image_url")
  icon     String?
  color    String?

  // Status
  status   String  @default("ACTIVE") // ACTIVE, INACTIVE, OUT_OF_STOCK, SEASONAL
  featured Boolean @default(false)

  createdBy String   @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  redemptions LaunchpadRedemption[]

  @@map("launchpad_rewards")
}

model LaunchpadRedemption {
  id String @id @default(cuid())

  studentId String           @map("student_id")
  student   LaunchpadStudent @relation(fields: [studentId], references: [id])

  rewardId String          @map("reward_id")
  reward   LaunchpadReward @relation(fields: [rewardId], references: [id])

  pointsSpent Int      @map("points_spent")
  cashValue   Decimal? @map("cash_value") @db.Decimal(12, 2)

  // Delivery
  status          String  @default("PENDING")
  deliveryMethod  String? @map("delivery_method")
  deliveryDetails Json?   @map("delivery_details") // {email, address, tracking}

  // Admin
  processedBy String?   @map("processed_by")
  processedAt DateTime? @map("processed_at")
  adminNotes  String?   @map("admin_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("launchpad_redemptions")
}

// ==================== BADGE TABLES ====================

model LaunchpadBadgeTemplate {
  id          String  @id @default(cuid())
  name        String  @unique
  displayName String  @map("display_name")
  description String? @db.Text

  // Visual
  icon      String
  color     String?
  animation String? // NONE, PULSE, SPARKLE, BOUNCE

  // Category
  category String // ACHIEVEMENT, MILESTONE, TRACK, SPECIAL, EVENT
  rarity   String // COMMON, UNCOMMON, RARE, EPIC, LEGENDARY, MYTHIC

  // Criteria (auto-award rules)
  criteriaType   String @map("criteria_type") // POINTS, LEVEL, TASK_COUNT, LEAD_COUNT, DEAL_COUNT, STREAK, CUSTOM
  criteriaValue  Int    @map("criteria_value")
  criteriaConfig Json?  @map("criteria_config") // {track, taskCategory, timePeriod}

  // Reward
  bonusPoints Int @default(0) @map("bonus_points")

  isActive Boolean @default(true) @map("is_active")
  isSecret Boolean @default(false) @map("is_secret") // Hidden until earned

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  earnedBadges LaunchpadBadge[]

  @@map("launchpad_badge_templates")
}

model LaunchpadBadge {
  id String @id @default(cuid())

  studentId String           @map("student_id")
  student   LaunchpadStudent @relation(fields: [studentId], references: [id])

  templateId String                 @map("template_id")
  template   LaunchpadBadgeTemplate @relation(fields: [templateId], references: [id])

  earnedAt DateTime @default(now()) @map("earned_at")
  earnedBy String   @default("AUTO") @map("earned_by") // AUTO or admin ID

  isNew    Boolean   @default(true) @map("is_new")
  sharedAt DateTime? @map("shared_at")

  @@unique([studentId, templateId])
  @@map("launchpad_badges")
}

// ==================== POINT TRANSACTIONS ====================

model LaunchpadPointTransaction {
  id String @id @default(cuid())

  studentId String           @map("student_id")
  student   LaunchpadStudent @relation(fields: [studentId], references: [id])

  amount       Int // Positive or negative
  balanceAfter Int @map("balance_after")

  // Source
  type     String // EARNED, SPENT, BONUS, PENALTY, ADJUSTMENT, REFUND
  source   String // TASK, LEAD, SUBMISSION, REDEMPTION, BADGE, MANUAL, REFERRAL
  sourceId String? @map("source_id")

  // Details
  description String?
  metadata    Json? // {taskId, submissionId, leadId, etc.}

  // Admin
  createdBy String? @map("created_by") // null for auto

  createdAt DateTime @default(now()) @map("created_at")

  @@map("launchpad_point_transactions")
}

// ==================== PROJECT ASSIGNMENTS ====================

model LaunchpadProjectAssignment {
  id String @id @default(cuid())

  studentId String           @map("student_id")
  student   LaunchpadStudent @relation(fields: [studentId], references: [id])

  osProjectId   String  @map("os_project_id")
  osProjectName String? @map("os_project_name")

  role        String // LEAD, SUPPORT, DEVELOPER, CONTENT, QA, DESIGN, INTERN
  title       String?
  description String? @db.Text

  // Compensation
  stipendAmount    Decimal? @map("stipend_amount") @db.Decimal(12, 2)
  stipendFrequency String   @default("PER_PROJECT") @map("stipend_frequency")
