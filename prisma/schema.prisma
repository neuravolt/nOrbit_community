// Technology Verification Plugin System, Phase 0. Resolves a legacy/alternate technologySlug
// string (e.g. "nodejs", "node-express") to the one real LaunchpadTechnology row it means. Exists
// ONLY for backward compatibility with data written before every technologySlug reference funneled
// through this table — new writes always use the canonical LaunchpadTechnology.slug directly.
// Replaces TECHNOLOGY_ADAPTERS[x].technologySlugs[] (validators/technology-adapter.ts).
model LaunchpadTechnologySlugAlias {
  id           String              @id @default(uuid())
  aliasSlug    String              @unique @map("alias_slug")
  technologyId String              @map("technology_id")
  technology   LaunchpadTechnology @relation(fields: [technologyId], references: [id], onDelete: Cascade)
  createdAt    DateTime            @default(now()) @map("created_at")

  @@index([technologyId])
  @@map("launchpad_technology_slug_aliases")
}

// Technology Verification Plugin System, Phase 0. THE unified, DB-driven replacement for:
// PatternConfig + AUTH_CONSTRUCT_BY_LANGUAGE + API_RESPONSE_CONSTRUCT_BY_LANGUAGE
// (pattern-engine.ts), NOTABLE_PATTERNS (notable-patterns.ts), TECHNOLOGY_ADAPTERS/
// CHALLENGE_SCAFFOLDS/VERIFICATION_ENGINE_FRAMEWORKS (technology-adapter.ts), the hardcoded Jest
// dispatch in sandbox.service.ts, the JS-only DANGEROUS_PATTERNS in
// broken-solutions-validation.service.ts, and the hardcoded 5-key COMPONENT_WEIGHTS in
// final-score.validator.ts.
//
// Versioned exactly like ChallengeTemplate/LaunchpadChallengeVerificationContract: never mutated
// in place, always a new row + previousVersionId + approvalStatus, so an already-frozen
// ChallengeBlueprint (via technologyPluginVersionId) can never be retroactively changed by an
// admin editing a technology's config after students are already mid-attempt.
model LaunchpadTechnologyPlugin {
  id                String              @id @default(uuid())
  technologyId      String              @map("technology_id")
  technology        LaunchpadTechnology @relation(fields: [technologyId], references: [id], onDelete: Cascade)
  versionNumber     Int                 @default(1) @map("version_number")
  previousVersionId String?             @map("previous_version_id")
  approvalStatus    String              @default("draft") @map("approval_status") // draft | approved | retired
  approvedBy        String?             @map("approved_by")
  approvedAt        DateTime?           @map("approved_at")
  createdBy         String?             @map("created_by")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  // --- pattern-engine.ts replacement -----------------------------------------------------------
  fileExtensions      String[] @map("file_extensions") // was PatternConfig.fileExtensions
  requirementPatterns Json     @map("requirement_patterns")
  // [{ prefix: string, matcherKind: string, args?: Json }] — matcherKind is a lookup key into the
  // small, named MATCHER_REGISTRY code file (matcher-registry.ts) — never inline code.

  // NOT NULL by design (the confirmed crash-risk fix): a technology with no real "auth"/"api-
  // response" concept (CSS, HTML, SQL) gets the literal never-matching regex source "(?!)" here,
  // not a missing map entry.
  authConstructPattern        String @map("auth_construct_pattern")
  apiResponseConstructPattern String @map("api_response_construct_pattern")

  // --- notable-patterns.ts replacement (pure data) -----------------------------------------------
  notablePatterns Json @default("[]") @map("notable_patterns")
  // [{ concept: string, patternSource: string, difficulty: "easy"|"medium"|"hard" }]

  // --- technology-adapter.ts's ChallengeScaffold replacement (pure data) -------------------------
  challengeScaffold Json? @map("challenge_scaffold") // { packageJson: object, babelConfig?: object } | null

  // --- sandbox.service.ts dispatch replacement -----------------------------------------------------
  solutionFileName            String  @default("solution.js") @map("solution_file_name")
  manifestFileName            String? @map("manifest_file_name") // e.g. "package.json", "composer.json", "requirements.txt"
  testRunnerKind              String  @default("process-exec") @map("test_runner_kind") // "process-exec" | "sql-comparison"
  noBuildStep                 Boolean @default(false) @map("no_build_step")
  installCommand              String? @map("install_command") // null = no install step (HTML/CSS/SQL)
  installTimeoutSec           Int     @default(60) @map("install_timeout_sec")
  buildCommand                String? @map("build_command") // null = no build step
  buildTimeoutSec             Int     @default(60) @map("build_timeout_sec")
  testCommandTemplate         String? @map("test_command_template") // "{testFile}"/"{outputFile}" placeholders; null for sql-comparison kind
  testFileExtension           String  @default(".test.js") @map("test_file_extension")
  testOutputFormat            String  @default("jest-json") @map("test_output_format") // key into TEST_OUTPUT_PARSERS
  testRunnerDefaultTimeoutSec Int     @default(30) @map("test_runner_default_timeout_sec")
  requiresTestService         Boolean @default(false) @map("requires_test_service")
  testServiceKind             String? @map("test_service_kind") // "mysql" | "redis" | "rabbitmq" | null
  infraRequirements           Json?   @map("infra_requirements") // string[] — surfaced as an admin warning banner

  // --- static-analysis.ts / lint.validator.ts replacement -----------------------------------------
  lintStrategy String @default("regex-js-ts") @map("lint_strategy") // key into LINT_STRATEGIES

  // --- ast-verification.validator.ts replacement --------------------------------------------------
  astFileExtensions String[] @default([]) @map("ast_file_extensions") // empty = ast-verification self-skips
  astStrategy       String   @default("typescript-compiler-api") @map("ast_strategy") // key into AST_STRATEGIES

  // --- new opt-in validator stages — each off by default, so migrating the 4 existing
  // technologies (react/express/vue/django) to their first plugin row is 100% behavior-preserving --
  memorySafetyEnabled        Boolean @default(false) @map("memory_safety_enabled")
  memorySafetyCommand        String? @map("memory_safety_command")
  concurrencySafetyEnabled   Boolean @default(false) @map("concurrency_safety_enabled")
  concurrencySafetyCommand   String? @map("concurrency_safety_command")
  performanceEnabled         Boolean @default(false) @map("performance_enabled")
  performanceInputSizes      Json?   @map("performance_input_sizes") // number[]
  performanceTimeLimitsMs    Json?   @map("performance_time_limits_ms") // number[] parallel to inputSizes
  performanceCommandTemplate String? @map("performance_command_template") // "{inputSize}" placeholder
  mutationTestingEnabled     Boolean @default(false) @map("mutation_testing_enabled")
  mutationTestingCommand     String? @map("mutation_testing_command")
  mutationTestingMinScore    Float   @default(60) @map("mutation_testing_min_score")
  typeCheckingEnabled        Boolean @default(false) @map("type_checking_enabled")
  typeCheckingCommand        String? @map("type_checking_command")
  typeCheckingBlocking       Boolean @default(false) @map("type_checking_blocking")

  // --- broken-solutions-validation.service.ts's DANGEROUS_PATTERNS replacement (pure data) --------
  dangerousPatterns Json @default("[]") @map("dangerous_patterns") // [{ flag: string, patternSource: string }]

  // --- final-score.validator.ts's COMPONENT_WEIGHTS replacement ------------------------------------
  scoreComponentWeights Json @map("score_component_weights") // { [stage: string]: number }

  // --- ai-generation-job-processor.ts's hidden-tests prompt fix ------------------------------------
  hiddenTestFrameworkName String  @map("hidden_test_framework_name") // e.g. "Jest", "PHPUnit", "pytest", "GoogleTest"
  hiddenTestPromptNotes   String? @map("hidden_test_prompt_notes") @db.Text

  // --- containerized-execution fields ---------------------------------------------------------------
  dockerImage   String @map("docker_image") // e.g. "registry.neuravolt.in/verify-python:3.11" — required, every technology runs in its own image, never the bare host
  memoryLimitMb Int    @default(512) @map("memory_limit_mb")
  cpuLimit      Float  @default(1.0) @map("cpu_limit")

  @@unique([technologyId, versionNumber])
  @@index([technologyId, approvalStatus])
  @@map("launchpad_technology_plugins")
}

model LaunchpadTechnologyLevel {
  id                     String              @id @default(uuid())
  technologyId           String              @map("technology_id")
  technology             LaunchpadTechnology @relation(fields: [technologyId], references: [id], onDelete: Cascade)
  levelNumber            Int                 @map("level_number")
  name                   String
  description            String?             @db.Text
  xpRequired             Int                 @default(0) @map("xp_required")
  estimatedDurationHours Int                 @default(40) @map("estimated_duration_hours")
  difficulty             String              @default("beginner")
  isActive               Boolean             @default(true) @map("is_active")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  // Launchpad Phase 5B, Slice 5B-6: {enabled: boolean, requiresVerificationPass?: boolean}. NULL
  // (the default for every existing Level) means auto-approval is off — zero behavior change
  // for a Level that hasn't opted in. Deliberately no `minConfidence` field yet: that's a
  // submission-scoring concept from the Verification Engine (§9/§11 of the plan), and there is
  // no confidence signal for a content-generation job to check it against — adding a numeric
  // field with nothing real behind it would be fabricated, not a policy.
  autoApprovalPolicy Json? @map("auto_approval_policy")

  nodes          LaunchpadRoadmapNode[]
  chapters       LaunchpadChapter[]
  generationRuns LaunchpadCurriculumGenerationRun[]

  @@unique([technologyId, levelNumber])
  @@index([technologyId])
  @@map("launchpad_technology_levels")
}

// Launchpad Phase 6, Slice 6-1: the orchestration parent for a Level's staged (7-stage) AI
// generation attempt — groups the individual per-stage LaunchpadAiGenerationJob rows a run fans
// out into (generationRunId below), so a Level's overall progress is a status rollup over its
// jobs rather than something inferred ad hoc. status/currentStage are computed/updated by the
// run-owning service (introduced this slice), not written directly by job processors.
model LaunchpadCurriculumGenerationRun {
  id                String                   @id @default(uuid())
  technologyLevelId String                   @map("technology_level_id")
  technologyLevel   LaunchpadTechnologyLevel @relation(fields: [technologyLevelId], references: [id], onDelete: Cascade)
  status            String                   @default("pending") // pending | in_progress | partial | completed | failed
  currentStage      String?                  @map("current_stage")
  createdBy         String?                  @map("created_by")
  createdAt         DateTime                 @default(now()) @map("created_at")
  completedAt       DateTime?                @map("completed_at")

  jobs LaunchpadAiGenerationJob[]

  @@index([technologyLevelId])
  @@map("launchpad_curriculum_generation_runs")
}

// Launchpad Phase 5B, Slice 5B-2: the first new curriculum-hierarchy layer. Confirmed directly
// (Phase 5B+6 plan, §2): Career/Role/Technology/Level already existed as real tables — Chapter
// and Topic were the two layers with zero matches anywhere in the schema before this. A
// "Syllabus" is deliberately NOT a table here either — it's the ordered set of a Level's
// Chapters (LaunchpadChapter.findMany({technologyLevelId}).orderBy(sortOrder)), matching the
// plan's own explicit call not to materialize it separately.
model LaunchpadChapter {
  id                String                   @id @default(uuid())
  technologyLevelId String                   @map("technology_level_id")
  level             LaunchpadTechnologyLevel @relation(fields: [technologyLevelId], references: [id], onDelete: Cascade)
  sortOrder         Int                      @default(1) @map("sort_order")
  title             String
  description       String?                  @db.Text
  objectivesSummary Json?                    @map("objectives_summary")
  status            String                   @default("draft")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  topics LaunchpadTopic[]

  @@index([technologyLevelId])
  @@map("launchpad_chapters")
}

model LaunchpadTopic {
  id                   String           @id @default(uuid())
  chapterId            String           @map("chapter_id")
  chapter              LaunchpadChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  sortOrder            Int              @default(1) @map("sort_order")
  title                String
  learningObjectives   Json?            @map("learning_objectives")
  prerequisiteTopicIds Json?            @map("prerequisite_topic_ids")
  status               String           @default("draft")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  nodes              LaunchpadRoadmapNode[]
  challengeTemplates ChallengeTemplate[]

  @@index([chapterId])
  @@map("launchpad_topics")
}

model LaunchpadRoadmapNode {
  id                String                   @id @default(uuid())
  technologyLevelId String                   @map("technology_level_id")
  level             LaunchpadTechnologyLevel @relation(fields: [technologyLevelId], references: [id], onDelete: Cascade)
  // Phase 5B, Slice 5B-2: nullable and additive — technologyLevelId above is never dropped by
  // this plan (see §16/§18's backward-compatibility rule). A node without a topicId falls back
  // to the flat technologyLevelId-based lookup everywhere that matters; the Slice 5B-2 backfill
  // script fills this in for every pre-existing node so it's populated going forward, but no
  // existing read path requires it to be non-null.
  topicId           String?                  @map("topic_id")
  topic             LaunchpadTopic?          @relation(fields: [topicId], references: [id], onDelete: SetNull)
  nodeNumber        Int                      @map("node_number")
  title             String
  slug              String
  description       String?                  @db.Text

  // Layer 6: Node Content
  learningObjectives Json   @map("learning_objectives")
  videos             Json   @map("videos")
  officialDocs       Json   @map("official_docs")
  notes              String @db.Text
  cheatsheet         String @db.Text
  codeExamples       Json   @map("code_examples")

  // Assessment & Challenge Data
  quizQuestions        Json @map("quiz_questions")
  codingChallenge      Json @map("coding_challenge")
  miniProject          Json @map("mini_project")
  aiInterviewQuestions Json @map("ai_interview_questions")
  validationRules      Json @map("validation_rules")

  // Rewards & Impacts
  xpReward        Int  @default(100) @map("xp_reward")
  coinsReward     Int  @default(50) @map("coins_reward")
  careerDnaImpact Json @map("career_dna_impact")
  skillMapping    Json @map("skill_mapping")

  estimatedDurationMinutes Int    @default(60) @map("estimated_duration_minutes")
  difficulty               String @default("beginner")
  prerequisites            Json?  @map("prerequisites")

  evaluationConfig Json?  @map("evaluation_config")
  trustLevel       String @default("A") @map("trust_level") // "A", "B", or "C"
  challengeType    String @default("guided") @map("challenge_type") // "guided", "project", "assessment"
  maxAttempts      Int?   @map("max_attempts")

  // Verification Engine: challenge cadence (Part 4a) — separate axis from challengeType above
  verificationChallengeType String @default("career") @map("verification_challenge_type") // "practice" | "career" | "milestone" | "capstone"
  difficultyMultiplier      Float  @default(1.0) @map("difficulty_multiplier")
  challengeVersion          Int    @default(1) @map("challenge_version") // bumped whenever requirements/evaluationConfig change; snapshotted into ChallengeEvaluationReport.challengeVersionId at Start

  status      String    @default("draft")
  version     Int       @default(1)
  createdBy   String?   @map("created_by")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Phase 1B (Node Versioning): a pending, unpublished edit to an already-published node.
  // Holds the same shape as the editable content fields above (title/description/notes/
  // cheatsheet/codeExamples/quizQuestions/codingChallenge/miniProject/evaluationConfig/etc,
  // whichever the admin changed). NULL means "no pending draft." Never read by any
  // student-facing query — student-facing selects explicitly whitelist fields and never
  // include this one (see roadmap.service.ts). Cleared back to NULL on publish.
  draftContent Json? @map("draft_content")

  studentProgress       LaunchpadStudentNodeProgress[]
  githubRepos           LaunchpadGithubRoadmapRepo[]
  testSuites            ChallengeTestSuite[]
  evaluationReports     ChallengeEvaluationReport[]
  contentVersions       LaunchpadContentVersion[]
  verificationContracts LaunchpadChallengeVerificationContract[]

  @@unique([technologyLevelId, nodeNumber])
  @@index([technologyLevelId])
  @@map("launchpad_roadmap_nodes")
}

// Phase B1 (Roadmap Runtime Verification Architecture): canonical, versioned challenge spec —
// one objective ("JWT Authentication") authored once (AI, human, or mixed, per non-negotiable
// #1), spawning many parameterized ChallengeInstance rows below. Additive: existing 1:1
// codingChallenge JSON on LaunchpadRoadmapNode/LaunchpadTask keeps working completely unchanged
// for any target that never opts into template-based generation (non-negotiable #8).
model ChallengeTemplate {
  id                 String          @id @default(uuid())
  technologySlug     String          @map("technology_slug")
  // `topic` (free-text title) is kept for display/backward-compat only — topicId below is the
  // real, authoritative connection to curriculum content. A string match on `topic` is fragile
  // (case-sensitive, no FK, silently matches nothing on a typo) and was the ONLY connection
  // before this field existed; every AI-generated template now sets topicId from the real
  // node.topic.id it was generated for, and the admin "Create Template" form requires picking a
  // real topic from a dropdown rather than typing free text.
  topicId            String?         @map("topic_id")
  topicRef           LaunchpadTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  topic              String
  title              String
  description        String?         @db.Text
  learningObjective  String          @map("learning_objective") @db.Text
  requirements       Json            @default("[]") // string[]
  evaluationCriteria Json            @default("[]") @map("evaluation_criteria") // string[]
  // The parameter value-space instances are generated from, e.g.
  // {"resourceName": ["users","orders","products"], "database": ["postgresql","mongodb"]}.
  parameterSchema    Json            @map("parameter_schema")
  // Fingerprint of technologySlug+topic+learningObjective+requirements+parameterSchema — the
  // deterministic "does this already exist" check non-negotiable #2/#8 calls for, so generation
  // never blindly re-drafts a template AI or a human already authored.
  templateHash       String          @unique @map("template_hash")
  // draft | validating | validated | published | retired — mirrors the existing
  // approvalStatus convention (LaunchpadChallengeVerificationContract) rather than inventing a
  // new vocabulary.
  status             String          @default("draft")
  versionNumber      Int             @default(1) @map("version_number")
  previousVersionId  String?         @map("previous_version_id")
  // "AI" | "MANUAL" | "MIXED" — same source-tracking convention LaunchpadContentVersion.source
  // already uses, applied here so a template's provenance survives independently of who reviews
  // it later.
  createdBySource    String          @default("MANUAL") @map("created_by_source")
  createdBy          String?         @map("created_by")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  instances ChallengeInstance[]

  @@index([technologySlug, topic])
  @@index([topicId])
  @@map("challenge_templates")
}

// Phase B1: one resolved parameterization of a ChallengeTemplate, bound to a specific target
// (roadmap_node or launchpad_task — same targetType/targetId convention every other polymorphic
// model in this schema already uses) and optionally a specific student. Deduped via
// instanceHash so 10,000 students reuse however many distinct parameter combinations actually
// get assigned, rather than triggering 10,000 independent generations.
model ChallengeInstance {
  id               String            @id @default(uuid())
  templateId       String            @map("template_id")
  template         ChallengeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  targetType       String            @default("roadmap_node") @map("target_type")
  targetId         String?           @map("target_id")
  // Nullable: an instance can be pre-generated into an unassigned pool (studentId null) before
  // being handed to a specific student, or generated directly for one student.
  studentId        String?           @map("student_id")
  // The specific parameter values resolved for this instance, e.g. {"resourceName": "orders",
  // "database": "mongodb"} — a subset of the template's parameterSchema value-space.
  parameters       Json
  // hash(templateId + sorted(parameters)) — the dedup key: before generating a new instance,
  // callers check for an existing VALIDATED-and-unassigned row with this hash first.
  instanceHash     String            @unique @map("instance_hash")
  problemStatement String            @map("problem_statement") @db.Text
  // draft | validating | validated | published | assigned | completed | retired
  status           String            @default("draft")
  versionNumber    Int               @default(1) @map("version_number")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@index([templateId])
  @@index([targetType, targetId])
  @@index([studentId])
  @@map("challenge_instances")
}

// Slice 5B-15 (Stage 6a — Challenge Verification Contracts). Lets one specific challenge diverge
// from its technology's default weights/gates without forking the technology-wide PatternConfig
// profile — opt-in per challenge by construction: a node with no contract row (or none approved)
// simply uses the technology default, unchanged. At most one contract per node in practice
// (ChallengeVerificationContractService.upsertDraft enforces this at the application layer, not
// via a DB unique constraint, mirroring this codebase's existing discipline-not-DB-guard pattern
// for append-only tables). No verificationProfileId FK — PatternConfig is a code registry (§10),
// not a database table, so technologySlug is a plain string, the same way
// VERIFICATION_ENGINE_FRAMEWORKS already keys off a slug.
model LaunchpadChallengeVerificationContract {
  id                   String                @id @default(uuid())
  // Phase A (Roadmap): nullable going forward — only populated (with the real FK) when
  // targetType is 'roadmap_node'. Existing rows backfilled targetType: 'roadmap_node',
  // targetId: <their nodeId>.
  nodeId               String?               @map("node_id")
  node                 LaunchpadRoadmapNode? @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  targetType           String                @default("roadmap_node") @map("target_type")
  targetId             String?               @map("target_id")
  technologySlug       String                @map("technology_slug")
  // Phase A (Roadmap): upsertDraft now always creates a new row instead of mutating the latest
  // one in place, so a contract edit can never retroactively change what an already-frozen
  // ChallengeEvaluationReport.challengeBlueprint was evaluated against. Callers that want "the
  // current contract" keep working unchanged — they already read the newest row via
  // findFirst/orderBy: createdAt desc, which is exactly the highest versionNumber.
  versionNumber        Int                   @default(1) @map("version_number")
  previousVersionId    String?               @map("previous_version_id")
  // Phase B1 (Roadmap Runtime Verification Architecture): loose reference to the
  // ChallengeInstance this contract governs, when the target uses template/instance-based
  // generation — same no-enforced-FK style targetId already uses on this model. Null for every
  // contract authored the pre-existing way (direct against a node/task, no instance involved).
  instanceId           String?               @map("instance_id")
  // Partial override of final-score.validator.ts's COMPONENT_WEIGHTS (architecture/requirement/
  // build/lint/unit-tests) — only the keys present here override the technology default; every
  // other key keeps its default weight.
  customWeights        Json?                 @map("custom_weights")
  // Additional requirement-prefix strings (same "prefix:value" vocabulary pattern-engine.ts
  // already resolves — e.g. "error-handling:required") evaluated alongside the challenge's own
  // requirements[] — never a new prefix category, never a new validator.
  customGates          Json?                 @map("custom_gates")
  // Phase C1 (Roadmap Runtime Verification Architecture — Contract-driven validator selection):
  // which of the fixed 15-stage validator vocabulary this specific challenge needs, beyond the
  // baseline-always-run set (ownership/structure/final-score — see ChallengeSpecCoverageService's
  // BASELINE_VALIDATORS). AI may suggest this at Stage 6a; ChallengeSpecCoverageService
  // independently verifies every requirement/evaluationCriteria entry is actually covered before
  // approval — this field is never trusted blind. Empty array (not null) for every contract
  // created before this field existed, so runVerification's union-with-baseline degrades to
  // "baseline only," never to "every requirement silently unchecked."
  requiredValidators   String[]              @default([]) @map("required_validators")
  publicTests          Json?                 @map("public_tests")
  expectedSolution     String?               @map("expected_solution") @db.Text
  brokenSolutions      Json?                 @map("broken_solutions")
  testValidationResult Json?                 @map("test_validation_result")
  // Phase C3 (Full-pipeline self-test): BrokenSolutionsValidationService.runFullPipelineSelfTest's
  // own rollup — separate column from testValidationResult (hidden-tests-only) since this proves
  // the whole 15-validator orchestrator chain, not just the hidden tests, discriminates
  // expectedSolution from brokenSolutions correctly.
  selfTestResult       Json?                 @map("self_test_result")
  approvalStatus       String                @default("draft") @map("approval_status") // draft | approved | rejected
  approvedBy           String?               @map("approved_by")
  approvedAt           DateTime?             @map("approved_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  testSuites ChallengeTestSuite[]

  @@index([nodeId])
  @@index([targetType, targetId, versionNumber])
  @@map("launchpad_challenge_verification_contracts")
}

// Launchpad Phase 5B, Slice 5B-1: immutable content version history. LaunchpadRoadmapNode's
// `version` Int and `draftContent` Json? are a fast-read cache of "what's live / what's
// pending" — neither preserves what a PREVIOUS version's content actually was. Confirmed
// directly (Phase 5B+6 plan, §2/§5): publishing a draft twice makes v1's content genuinely
// unrecoverable via any existing query. This table is the append-only history that was
// missing — mirrors ChallengeScoreVersion's existing pattern (schema.prisma:3610, "every
// recalculation appends a version instead of overwriting"), applied to content instead of
// scores. Rows are never updated or deleted — enforced the same way ChallengeScoreVersion's
// append-only-ness already is: by discipline in the calling service (only .create() is ever
// called), not a DB-level guard — confirmed no such guard exists for ChallengeScoreVersion
// either before adding a new, inconsistent one here.
model LaunchpadContentVersion {
  id                String               @id @default(uuid())
  nodeId            String               @map("node_id")
  node              LaunchpadRoadmapNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  section           String               @default("full") @map("section") // "full" until Slice 5B-4 (sub-field regeneration) lands
  versionNumber     Int                  @map("version_number") // per-node-per-section monotonic counter — deliberately independent of LaunchpadRoadmapNode.version, which counts publishes only
  content           Json // full snapshot of the editable-content fields at this version
  source            String // "AI" | "MANUAL"
  status            String // "draft" | "published"
  generationJobId   String?              @map("generation_job_id") // LaunchpadAiGenerationJob.id when source = "AI" — no enforced FK, same loose-reference style LaunchpadAiGenerationJob.careerId already uses
  instruction       String?              @map("instruction") @db.Text
  previousVersionId String?              @map("previous_version_id") // this node+section's prior version row, if any — same loose-reference style, avoids self-relation FK complexity for a simple history pointer
  reviewerId        String?              @map("reviewer_id")
  reviewedAt        DateTime?            @map("reviewed_at")
  createdAt         DateTime             @default(now()) @map("created_at")

  staleMarkersTriggered LaunchpadStaleMarker[]

  @@index([nodeId])
  @@index([nodeId, section, versionNumber])
  @@map("launchpad_content_versions")
}

// Slice 5B-12: warning-only, insert-only. entityType/entityId are a loose reference (same
// convention as LaunchpadContentVersion.generationJobId) — "quiz"/"challenge" today point at
// fields on LaunchpadRoadmapNode (entityId = nodeId), since neither is its own table yet.
// Explicit lock (§3): no code path reads this table and takes action on its own — resolving a
// marker always requires an explicit professor decision via the resolve endpoint.
model LaunchpadStaleMarker {
  id                   String                  @id @default(uuid())
  entityType           String                  @map("entity_type")
  entityId             String                  @map("entity_id")
  triggeredByVersionId String                  @map("triggered_by_version_id")
  triggeredByVersion   LaunchpadContentVersion @relation(fields: [triggeredByVersionId], references: [id], onDelete: Cascade)
  staleSince           DateTime                @default(now()) @map("stale_since")
  resolvedAt           DateTime?               @map("resolved_at")
  professorDecision    String?                 @map("professor_decision") // "REGENERATE" | "KEEP" | "EDIT_MANUALLY"
  createdAt            DateTime                @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("launchpad_stale_markers")
}

