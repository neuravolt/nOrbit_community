model LaunchpadAiGenerationJob {
  id              String                            @id @default(uuid())
  jobType         String                            @map("job_type")
  status          String                            @default("queued")
  targetType      String                            @map("target_type")
  // Genuinely polymorphic since the Stage 1-7 pipeline (Slice 6-1 onward): a syllabus job's
  // target is a Level, a chapter-detail/topics job's target is a Chapter, a content/assessment/
  // verification-contract job's target is a RoadmapNode. A real FK to LaunchpadRoadmapNode here
  // was wrong from the start — it happened to go unnoticed because every prior test exercised
  // this against a mocked Prisma, never a real Postgres FK check. No enforced relation, same
  // loose-reference style `careerId` below already uses on this exact model.
  targetId        String                            @map("target_id")
  bullmqJobId     String?                           @map("bullmq_job_id")
  inputData       Json?                             @map("input_data")
  outputData      Json?                             @map("output_data")
  errorMessage    String?                           @map("error_message") @db.Text
  retryCount      Int                               @default(0) @map("retry_count")
  maxRetries      Int                               @default(3) @map("max_retries")
  reviewStatus    String                            @default("pending") @map("review_status")
  reviewedBy      String?                           @map("reviewed_by")
  reviewedAt      DateTime?                         @map("reviewed_at")
  careerId        String?                           @map("career_id")
  // Slice 6-1: nullable and additive — every job type that predates the staged pipeline (content/
  // quiz/challenge/hidden-tests/planner) has no run to belong to and stays null forever. Only the
  // Stage 1-7 job types this and later slices introduce ever populate it.
  generationRunId String?                           @map("generation_run_id")
  generationRun   LaunchpadCurriculumGenerationRun? @relation(fields: [generationRunId], references: [id], onDelete: SetNull)
  createdAt       DateTime                          @default(now()) @map("created_at")
  updatedAt       DateTime                          @updatedAt @map("updated_at")

  @@index([targetId])
  @@index([careerId])
  @@index([generationRunId])
  @@map("launchpad_ai_generation_jobs")
}

