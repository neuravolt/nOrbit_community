// One row per (agent, discovered WordPress site) per scan run — versioned by scannedAt, never
// mutated in place, so "what changed since last time" is a query against the prior row for the
// same (agentId, domain), the same comparison-against-history discipline already used elsewhere
// in this codebase (e.g. git-forensics comparing against previously-synced GithubCommit rows).
// Built after the ecoprobuilders.in incident (a rogue admin account, a mu-plugins dropper, and DB
// bloat went undetected for months) confirmed Guardian had zero WordPress-application-level
// visibility — every field here targets one of that incident's actual indicators.
model GuardianWordPressScan {
  id      String        @id @default(cuid())
  agentId String        @map("agent_id")
  agent   GuardianAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  // Resolved by matching the discovered domain against Asset.name (type HOSTING/WEBSITE) — nullable:
  // a WordPress site Guardian can see but can't map to a billing/commercial Asset row still gets
  // scanned and alerted on, just without a dashboard-asset link.
  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  domain    String
  path      String
  scannedAt DateTime @default(now()) @map("scanned_at")

  adminUsers              Json @map("admin_users") // [{id, login, email, registered}] — full snapshot, this run
  newAdminsSinceLastScan  Json @default("[]") @map("new_admins_since_last_scan")
  suspiciousAdminAccounts Json @default("[]") @map("suspicious_admin_accounts") // baseline-independent, e.g. registered date 0000-00-00

  muPluginFiles             Json @default("[]") @map("mu_plugin_files") // [{name, size, mtime}]
  newOrChangedMuPluginFiles Json @default("[]") @map("new_or_changed_mu_plugin_files")

  suspiciousUploadPhpFiles Json @default("[]") @map("suspicious_upload_php_files") // PHP files under wp-content/uploads/, excluding known-benign placeholders

  // Guardian Load-Safe Architecture plan, Phase 6: full {name,size,mtime} metadata for every PHP
  // file under wp-content/uploads seen THIS scan — not just the suspicious ones. Diffed against
  // the previous scan's copy of this field to skip re-reading unchanged files' content, mirroring
  // the muPluginFiles diff pattern above but actually skipping the read (not just diffing after
  // fetching everything every time).
  uploadsFileInventory Json @default("[]") @map("uploads_file_inventory")

  dbBloatFindings Json @default("[]") @map("db_bloat_findings") // [{table, rowCount, thresholdExceeded: true}]

  // 'protected' | 'issues_found' | 'error' — 'error' is load-bearing: a failed SSH/wp-cli call
  // must never silently roll up as 'protected'. Never conflate "couldn't check" with "checked, clean."
  overallStatus String  @map("overall_status")
  errorMessage  String? @map("error_message")

  @@index([agentId, domain, scannedAt])
  @@index([assetId])
  @@map("guardian_wordpress_scans")
}

// Forensic Quarantine Registry — one row per quarantined file, never deleted.
// Enables developers to: (a) see exactly what was quarantined and when,
// (b) restore a false-positive file back to its original WordPress path,
// (c) audit the full chain of custody (quarantine -> restored / permanently purged).
// originalPath is the absolute server path before quarantine.
// quarantinePath is where the file lives now (/var/quarantine/wp_<ts>_<name>.quarantine).
// fileHash (SHA-256) allows verifying the restored file is byte-identical to what was quarantined.
// restoredAt / restoredBy track who did the restore and when.
model GuardianQuarantineRecord {
  id      String        @id @default(cuid())
  agentId String        @map("agent_id")
  agent   GuardianAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  // Source alert that triggered this quarantine (nullable — may be triggered manually)
  alertId String? @map("alert_id")

  // WordPress site this file belonged to
  domain   String
  sitePath String @map("site_path")

  // File identity
  originalPath   String  @map("original_path") // e.g. /var/www/.../mu-plugins/helix-archiver.php
  quarantinePath String? @map("quarantine_path") // null if purged (permanent delete)
  fileName       String  @map("file_name")
  fileSizeBytes  Int?    @map("file_size_bytes")
  fileHashSha256 String? @map("file_hash_sha256") // SHA-256 of file content at time of quarantine
  fileContent    String? @map("file_content") // First 4KB of file content for forensic review (safe preview)

  // Quarantine action
  action        String   @default("QUARANTINED") // "QUARANTINED" | "PURGED"
  reason        String? // Human-readable reason (e.g. "mu-plugins dropper detected")
  quarantinedAt DateTime @default(now()) @map("quarantined_at")
  quarantinedBy String?  @map("quarantined_by") // "GUARDIAN_AUTO" | user ID if manual

  // Restore tracking
  status     String    @default("QUARANTINED") // "QUARANTINED" | "RESTORED" | "PURGED"
  restoredAt DateTime? @map("restored_at")
  restoredBy String?   @map("restored_by") // user ID or "MANUAL"
  restoreLog String?   @map("restore_log") // Any notes from the restore operation

  @@index([agentId, domain])
  @@index([alertId])
  @@index([status])
  @@map("guardian_quarantine_records")
}

// --- Guardian Core: load-safe scanning / synthetic-monitoring / fleet-operations (Phase 1) ---
// See GUARDIAN_LOAD_SAFE_ARCHITECTURE plan: AUDIT -> PRESERVE -> REUSE -> EXTEND -> SECURE ->
// LOAD-SAFE -> TEST -> VERIFY. These models back Planes 1/3/4 (synthetic monitoring, remote
// security scanning, fleet operations) — Plane 2 (telemetry) is unchanged and uses GuardianMonitor.

model DomainObservation {
  id        String @id @default(cuid())
  websiteId String @map("website_id")

  resolvedRecordType String @map("resolved_record_type") // "A" | "AAAA" | "CNAME"
  resolvedValues     Json   @map("resolved_values") // raw resolved IPs/hostnames, this check

  endpointModel String? @map("endpoint_model") // "DIRECT_VPS_IP" | "CLOUDFLARE_ANYCAST" | "OTHER_CDN" | "UNKNOWN"
  expectedIp    String? @map("expected_ip") // denormalized baseline snapshot at check-time

  driftDetected Boolean @default(false) @map("drift_detected")
  driftReason   String? @map("drift_reason")
  nameservers   Json?   @map("nameservers")

  // Append-only history — never updated in place, one row per check.
  checkedAt DateTime @default(now()) @map("checked_at")

  website Asset @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, checkedAt])
  // Backs the fleet dashboard's "currently drifted domains" filter without scanning full history.
  @@index([websiteId, driftDetected])
  @@map("guardian_domain_observations")
}

model TLSObservation {
  id        String @id @default(cuid())
  websiteId String @map("website_id")

  resolvedSans  Json    @map("resolved_sans")
  hostnameMatch Boolean @map("hostname_match")

  issuer          String?   @map("issuer")
  subject         String?   @map("subject")
  validFrom       DateTime? @map("valid_from")
  validTo         DateTime? @map("valid_to")
  daysUntilExpiry Int?      @map("days_until_expiry")

  isParkingPage         Boolean @default(false) @map("is_parking_page")
  parkingPageConfidence Int?    @map("parking_page_confidence") // 0-100

  tlsProtocol String? @map("tls_protocol")

  checkedAt    DateTime @default(now()) @map("checked_at") // append-only history
  errorMessage String?  @map("error_message") // a failed check must never roll up as "clean"

  website Asset @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, checkedAt])
  // Backs the SSL_DOMAIN_MISMATCH alert query: fleet-wide "wrong cert for this host".
  @@index([websiteId, hostnameMatch])
  @@map("guardian_tls_observations")
}

model SecurityFinding {
  id      String  @id @default(cuid())
  assetId String  @map("asset_id")
  agentId String? @map("agent_id") // set only when the finding required on-host execution

  // Plain strings, not enums — mirrors GuardianCommand.commandType's documented rationale: new
  // scanners and finding subtypes must not require a schema migration each time.
  source      String @map("source") // "WEB_SHELL_SCANNER" | "SENSITIVE_FILE_PROBE" | "SECURITY_HEADER_AUDIT" | ...
  findingType String @map("finding_type") // "WEBSHELL_DETECTED" | "ENV_FILE_EXPOSED" | "MISSING_HSTS_HEADER" | ...

  // Deterministic dedup identity — application layer looks up an OPEN finding with the same
  // (assetId, fingerprint) before creating a new row; only creates a new row if none is OPEN, so a
  // resolved-then-recurring issue gets fresh history instead of being silently merged.
  fingerprint String @map("fingerprint") // hash(findingType + filePath|url + normalized evidence key)

  // Confidence semantics (documented, not just typed):
  //   0-39  = LOW    (single weak heuristic signal, high false-positive rate expected)
  //   40-69 = MEDIUM (multiple corroborating signals)
  //   70-100 = HIGH  (near-certain pattern match, e.g. known web-shell signature)
  severity        AlertSeverity
  confidenceScore Int           @default(100) @map("confidence_score")

  // MUST be redacted (secrets/credentials/tokens stripped) by the writer service before this is
  // persisted — a JSON column can't self-sanitize; enforced in code review / Definition of Done.
  evidence Json    @map("evidence")
  filePath String? @map("file_path") // set for filesystem-based findings
  url      String? @map("url") // set for HTTP-probed findings

  detectedAt DateTime @default(now()) @map("detected_at")

  status          String    @default("OPEN") @map("status") // OPEN | ACKNOWLEDGED | RESOLVED | DISMISSED | FALSE_POSITIVE
  resolvedAt      DateTime? @map("resolved_at")
  resolvedBy      String?   @map("resolved_by")
  dismissedReason String?   @map("dismissed_reason")

  asset Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  agent GuardianAgent? @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([assetId, status])
  // Backs the dedup lookup described above.
  @@index([assetId, fingerprint, status])
  @@index([agentId])
  @@map("guardian_security_findings")
}

model FleetOperation {
  id String @id @default(cuid())

  // Actor identity for fast display — mirrored into AuditLog at creation time by the writer
  // service (reuses existing audit infrastructure rather than a second logging path). Always read
  // from the authenticated request context server-side, never from a user-supplied request field.
  initiatedBy String @map("initiated_by")

  actionType String @map("action_type") // "RESTART_NGINX" | "RESTART_PM2" | "UPDATE_AGENT" | ...
  payload    Json?  @map("payload") // MUST be redacted before write, same rule as SecurityFinding.evidence

  // A retried request with the same key returns the existing operation instead of creating a
  // duplicate — retry-safety for privileged fleet-wide actions.
  idempotencyKey String @unique @map("idempotency_key")

  status String @default("QUEUED") @map("status") // QUEUED -> RUNNING -> COMPLETED | FAILED | CANCELLED

  totalTargets   Int @default(0) @map("total_targets")
  succeededCount Int @default(0) @map("succeeded_count")
  failedCount    Int @default(0) @map("failed_count")

  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  targets FleetOperationTarget[]

  // Tenant scope is deliberately NOT duplicated onto this model — it's derived via
  // FleetOperationTarget.agentId -> GuardianAgent.serverId -> Asset.clientId -> Client, and
  // enforced server-side at operation-creation time (reject if targets span more than the actor's
  // authorized tenant scope).
  @@index([status, createdAt])
  @@map("guardian_fleet_operations")
}

model FleetOperationTarget {
  id               String @id @default(cuid())
  fleetOperationId String @map("fleet_operation_id")
  agentId          String @map("agent_id")

  // Independent from FleetOperation.status by design — one server's failure doesn't imply or
  // block the others.
  status       String    @default("PENDING") @map("status") // PENDING -> DISPATCHED -> RUNNING -> SUCCESS | FAILED | SKIPPED
  result       Json?     @map("result") // MUST be redacted before write, same rule as above
  errorMessage String?   @map("error_message")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")

  fleetOperation FleetOperation @relation(fields: [fleetOperationId], references: [id], onDelete: Cascade)
  agent          GuardianAgent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([fleetOperationId, agentId])
  @@index([agentId])
  @@map("guardian_fleet_operation_targets")
}

// Guardian Load-Safe Architecture plan, Phase 7: incremental-scan cursor for the universal
// web-shell scanner — one row per (assetId, source), upserted each run. Mirrors the pattern
// proven in Phase 6's GuardianWordPressScan.uploadsFileInventory field, generalized into its own
// small model since SecurityFinding itself is per-finding, not a natural home for a whole-scan
// file inventory snapshot.
model GuardianFileScanCursor {
  id      String @id @default(cuid())
  assetId String @map("asset_id")
  source  String // "WEB_SHELL_SCANNER" — matches SecurityFinding.source values

  fileInventory Json     @default("[]") @map("file_inventory") // [{path, size, mtime}]
  lastScannedAt DateTime @default(now()) @map("last_scanned_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, source])
  @@map("guardian_file_scan_cursors")
}

model ClientEnterpriseSetting {
