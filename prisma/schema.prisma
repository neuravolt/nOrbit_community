  startDate     DateTime  @map("start_date")
  endDate       DateTime? @map("end_date")
  expectedHours Float?    @map("expected_hours")
  actualHours   Float?    @map("actual_hours")

  // Deliverables
  deliverables Json? // [{name, description, status, dueDate, completedAt}]
  milestones   Json? // [{name, date, status, notes}]

