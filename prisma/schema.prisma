model LaunchpadPartnerUser {
  id                 String   @id @default(cuid())
  partnerId          String   @map("partner_id")
  userId             String   @map("user_id") // legacy, unused — kept as-is, not relied on by new auth below
  role               String // "ADMIN", "MENTOR", "VIEWER"
  department         String?
  canCreateBatches   Boolean  @default(false) @map("can_create_batches")
  canViewReports     Boolean  @default(true) @map("can_view_reports")
  canMessageStudents Boolean  @default(false) @map("can_message_students")
  createdAt          DateTime @default(now()) @map("created_at")

  // Self-contained login for a partner-side user (e.g. a college TPO),
  // mirroring LaunchpadStudent's own auth fields rather than depending on
  // the unused `userId` above or the internal-staff User/Roles system.
  email                 String?   @unique @map("email")
  fullName              String?   @map("full_name")
  passwordHash          String?   @map("password_hash")
  tokenVersion          Int       @default(1) @map("token_version")
  mustChangePassword    Boolean   @default(false) @map("must_change_password")
  tempPasswordExpiresAt DateTime? @map("temp_password_expires_at")
  lastLoginAt           DateTime? @map("last_login_at")

  partner       LaunchpadPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@map("launchpad_partner_users")
}

enum LaunchpadBatchJoinMode {
  AUTO
  APPROVAL_REQUIRED
}

model LaunchpadBatch {
  id                 String    @id @default(cuid())
  partnerId          String    @map("partner_id")
  name               String // "CS 2026 Batch", "Cloud Team Alpha"
  description        String?
  curriculumId       String?   @map("curriculum_id")
  startDate          DateTime? @map("start_date")
  endDate            DateTime? @map("end_date")
  maxStudents        Int       @default(50) @map("max_students")
  primaryMentorId    String?   @map("primary_mentor_id")
  secondaryMentorIds Json?     @map("secondary_mentor_ids") // Array of string IDs
  status             String    @default("upcoming") // "upcoming", "active", "completed", "cancelled"
  createdAt          DateTime  @default(now()) @map("created_at")

  // Student self-enrollment. Nullable so existing admin-bulk-enrolled
  // batches (created before this) are unaffected; a TPO opts in per batch.
  joinCode String?                 @unique @map("join_code")
  joinMode LaunchpadBatchJoinMode? @default(AUTO) @map("join_mode")

  partner     LaunchpadPartner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  enrollments LaunchpadBatchEnrollment[]

  @@map("launchpad_batches")
}

model LaunchpadBatchEnrollment {
  id              String    @id @default(cuid())
  batchId         String    @map("batch_id")
