  policy                   LeavePolicy    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  leaveType                LeaveType
  allowedDays              Decimal        @db.Decimal(5, 2)
  accrualType              String // "ANNUAL" | "MONTHLY" | "NONE"
  accrualTiming            AccrualTiming  @default(MONTH_START)
  monthlyAccrualRate       Decimal        @default(0.00) @db.Decimal(5, 2)
  probationAllowed         Boolean        @default(true)
  carryForward             Boolean        @default(false)
  maxCarryForwardDays      Decimal        @default(0.00) @db.Decimal(5, 2)
  carryForwardExpiryMonths Int?
  sandwichPolicy           SandwichPolicy @default(NONE)
  halfDayAllowed           Boolean        @default(true)
  hourlyAllowed            Boolean        @default(false)
  requests                 LeaveRequest[]
  createdAt                DateTime       @default(now())

  @@unique([policyId, leaveType])
}

model EmployeeLeavePolicy {
  id            String      @id @default(uuid())
  employeeId    String
  employee      User        @relation("AssignedPoliciesEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  policyId      String
  policy        LeavePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  effectiveFrom String
  effectiveTo   String?
  assignedById  String?
  assignedBy    User?       @relation("AssignedPoliciesCreated", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@index([employeeId, effectiveFrom])
}

model LeaveBalance {
  id             String     @id @default(uuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType      LeaveType
  cycleId        String
  cycle          LeaveCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  allocated      Decimal    @default(0.00) @db.Decimal(6, 2)
  accrued        Decimal    @default(0.00) @db.Decimal(6, 2)
  used           Decimal    @default(0.00) @db.Decimal(6, 2)
  pending        Decimal    @default(0.00) @db.Decimal(6, 2)
  carriedForward Decimal    @default(0.00) @db.Decimal(6, 2)
  available      Decimal    @default(0.00) @db.Decimal(6, 2)
  updatedAt      DateTime   @updatedAt

  @@unique([userId, leaveType, cycleId])
  @@index([userId, cycleId])
