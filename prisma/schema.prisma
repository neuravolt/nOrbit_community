model Asset {
  id           String    @id @default(uuid())
  name         String
  type         AssetType
  description  String?
  clientId     String
  metadata     Json      @default("{}")
  renewalDate  DateTime?
  cost         Float?
  billingCycle String?   @default("ANNUALLY")
  notes        String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  client       Client    @relation(fields: [clientId], references: [id])
  invoices     Invoice[]
  quoteId      String?   @unique
  quote        Quote?    @relation(fields: [quoteId], references: [id])

  // Guardian linkage
  guardianAgentId   String?
  guardianAgent     GuardianAgent?         @relation("AgentToMonitoredAssets", fields: [guardianAgentId], references: [id], onDelete: SetNull)
  hostAgent         GuardianAgent?         @relation("AgentToHostServer")
  guardianMode      GuardianMode           @default(MANAGED) @map("guardian_mode")
  guardianOwnership GuardianOwnership      @default(NEURAVOLT) @map("guardian_ownership")
  guardianStatus    GuardianStatus         @default(PENDING) @map("guardian_status")
  environment       AssetEnvironment       @default(PRODUCTION)
  installTokens     GuardianInstallToken[]

  // Auto-discovered fields
  projectType   String? // "WordPress", "Node.js", etc.
  phpVersion    String?
  databaseType  String?
  sslIssuer     String?
  sslExpiryDate DateTime?
  diskUsageMB   Int?
  totalPlugins  Int?
  activeTheme   String?
  cronEnabled   Boolean   @default(false)
  cacheType     String? // "LiteSpeed", "Redis", "None"

  // Monitoring
  isMonitored     Boolean @default(false)
  monitorInterval Int     @default(60) // seconds

  // Relations
  monitors       GuardianMonitor[]
  alerts         GuardianAlert[]
  nginxConfig    NginxConfig?            @relation("WebsiteToNginxConfig")
  wordpressScans GuardianWordPressScan[]

  // Guardian Core load-safe architecture (Phase 1)
  domainObservations DomainObservation[]
  tlsObservations    TLSObservation[]
  securityFindings   SecurityFinding[]
  fileScanCursors    GuardianFileScanCursor[]

  // Which AMC contracts cover this asset — see AmcContract.assets for the reasoning.
  amcContracts AmcContract[] @relation("AmcContractAssets")

  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

