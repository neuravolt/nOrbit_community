  emailedTo    Json?    @map("emailed_to") // Array of emails
  downloadedBy Json?    @map("downloaded_by") // Array of user IDs
  createdAt    DateTime @default(now()) @map("created_at")

  partner LaunchpadPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("launchpad_partner_reports")
}

model LaunchpadCareer {
