  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User             @relation("UserSentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organizationId])
}

model OrganizationSettings {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  timezone       String       @default("UTC")
  workingHours   Float        @default(8.0)
  leaveYearStart DateTime?
  currency       String       @default("INR")

  // ─── Dynamic Payroll Configuration (Admin-Editable) ──────────────────────
  // All rates stored here so any company can customize without code changes.
  // Payroll engine reads these at run-time; per-employee overrides still apply.

  // PF / EPF (EPF Act 1952)
  // Admin can set 11%, 12%, or any rate. Statutory minimum = 12%.
  // Some employers cap PF on ₹15,000 ceiling; others pay on actual basic.
  pfEmployeeRate Float   @default(0.12) // Employee contribution rate (default 12%)
  pfEmployerRate Float   @default(0.12) // Employer contribution rate (default 12%)
  pfWageCeiling  Float   @default(15000) // Statutory cap; set to 999999 to remove cap
  pfApplyWageCap Boolean @default(true) // true = cap at pfWageCeiling; false = on full basic
  pfEnabled      Boolean @default(true) // Can disable PF entirely for exempt organisations

  // ESI (ESI Act 1948)
  esiEmployeeRate Float   @default(0.0075) // 0.75% employee contribution
  esiEmployerRate Float   @default(0.0325) // 3.25% employer contribution
  esiGrossCeiling Float   @default(21000) // ESI applies only if gross ≤ this amount
  esiEnabled      Boolean @default(true)

  // Professional Tax — state-specific; admin sets their state's slabs
  // Stored as JSON array: [{ upTo: 14999, amount: 0 }, { upTo: 19999, amount: 150 }, { upTo: 9999999, amount: 200 }]
  // Default = Karnataka slab
  ptState     String  @default("Karnataka")
  ptSlabsJson String  @default("[{\"upTo\":14999,\"amount\":0},{\"upTo\":19999,\"amount\":150},{\"upTo\":9999999,\"amount\":200}]")
  ptEnabled   Boolean @default(true)

  // LWP / Salary Days Calculation
  // "CALENDAR" = actual days in month; "FIXED_26" = 26 working days; "FIXED_30" = 30 days
  lwpCalculationBase String @default("CALENDAR")

  // Default conveyance allowance per employment type (INR/month)
  defaultConveyanceEmployee Float @default(1600)
  defaultConveyanceIntern   Float @default(0)
  defaultConveyanceContract Float @default(0)

  // Default tax regime for new employees
  defaultTaxRegime String @default("NEW") // "NEW" | "OLD"

  // Employment type defaults — auto-applied when salary is set up
  // Stored as JSON: { EMPLOYEE: { pfApplicable: true, esiApplicable: true },
  //                   PAID_INTERN: { pfApplicable: false, esiApplicable: false, ptOverride: 0 }, ... }
  employmentTypeDefaultsJson String @default("{\"EMPLOYEE\":{\"pfApplicable\":true,\"esiApplicable\":true},\"PAID_INTERN\":{\"pfApplicable\":false,\"esiApplicable\":false,\"ptOverride\":0},\"CONTRACT\":{\"pfApplicable\":false,\"esiApplicable\":false,\"tdsRate\":0.10},\"UNPAID_INTERN\":{\"pfApplicable\":false,\"esiApplicable\":false,\"ptOverride\":0,\"skipPayroll\":true}}")

  // High-package PF rule (many MNCs cap PF for high-earners)
  // Employees with basic > highPackageBasicThreshold can opt out of PF
  highPackageBasicThreshold Float   @default(999999) // set lower (e.g. 50000) to enable
  highPackagePfOptional     Boolean @default(false)

  updatedAt DateTime @default(now()) @updatedAt
}

// ─── Dynamic SaaS Plans & Subscriptions ──────────────────────────────────────

model Plan {
  id                    String                     @id @default(uuid())
  name                  String                     @unique
  slug                  String                     @unique
  description           String?

  // Multi-Currency & Interval Pricing
  priceMonthlyINR       Float                      @default(0)
  priceYearlyINR        Float                      @default(0)
  priceMonthlyUSD       Float                      @default(0)
  priceYearlyUSD        Float                      @default(0)

  // Resource Limits (-1 denotes unlimited)
  maxMembers            Int                        @default(5)
  maxProjects           Int                        @default(10)
  maxServers            Int                        @default(1)

  // Feature Toggles
  featureProjectsTasks  Boolean                    @default(true)
  featureCrm            Boolean                    @default(true)
  featureBilling        Boolean                    @default(true)
  featureGuardianByovps Boolean                    @default(false)
  featureClientPortal   Boolean                    @default(false)
  featureApiAccess      Boolean                    @default(false)

  // Visibility & State Toggles
  isPublic              Boolean                    @default(true)
  isActive              Boolean                    @default(true)
  sortOrder             Int                        @default(0)

  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  deletedAt             DateTime?

  subscriptions         OrganizationSubscription[]
}

model OrganizationSubscription {
  id                   String        @id @default(uuid())
  organizationId       String        @unique
  planId               String
  status               String        @default("ACTIVE") // ACTIVE, TRIAL, EXPIRED, CANCELLED
  billingInterval      String        @default("MONTHLY") // MONTHLY, YEARLY
  currency             String        @default("INR")     // INR, USD

  // Custom Limit Overrides (null means inherit from plan)
  customMaxMembers     Int?
  customMaxProjects    Int?
  customMaxServers     Int?

  // Expiry Dates
  expiresAt            DateTime?
  trialExpiresAt       DateTime?

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                 Plan          @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([planId])
  @@index([status])
}

