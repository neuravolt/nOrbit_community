# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/neuravolt"

# JWT Configuration
JWT_SECRET="your-super-secret-key-minimum-32-characters-long-for-production"
JWT_REFRESH_SECRET="your-refresh-secret-minimum-32-characters-long-for-production"

# Server Ports
API_PORT=3001
WEB_PORT=3000
WORKER_PORT=3002

# Redis
REDIS_URL="redis://localhost:6379"

# Environment
NODE_ENV=development

# CORS — comma-separated list of allowed frontend origins (production)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3003"

# BullMQ Worker concurrency (default: 5)
WORKER_CONCURRENCY=5

# SMTP Email Configuration
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=yourpassword
SMTP_FROM="NeuraVolt <no-reply@yourdomain.com>"
SMTP_SECURE=false

# Storage
STORAGE_PATH=./uploads

# Client Portal URL (used in email links)
CLIENT_PORTAL_URL=http://localhost:3003

# API public URL (used in email attachment links)
API_BASE_URL=http://localhost:3001

# Gemini AI (roadmap/quiz/challenge generation, career assessment). Falls back to
# static mock content in apps/worker and the assessment service if unset.
GEMINI_API_KEY=

# GitHub App (student "Connect GitHub" flow: apps/api/src/modules/github).
# Create a GitHub App at https://github.com/settings/apps/new, generate a private key,
# and set the org/account it's installed on. Without these, GitHub sync is skipped
# (no fake data is generated) rather than failing silently with mock data.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# GitHub org token (repo scope) used to auto-create mini-project repos for students.
# Without this, repo creation jobs are marked "error" instead of faking a repo URL.
GITHUB_ORG_TOKEN=
GITHUB_ORG_NAME=incubator-org

# Encryption key for secrets stored at rest (Asset credentials, Razorpay key secret).
ENCRYPTION_KEY=

# Razorpay is configured per-company from Settings -> Company Profile -> Bank & Payments
# in the admin app (admin toggles Manual vs Razorpay and enters the Key ID/Secret there —
# no env vars needed for this one). This just documents that the toggle exists.
