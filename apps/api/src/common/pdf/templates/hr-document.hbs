<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>{{title}}</title>
  <style>
    body { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1e293b; padding: 45px; line-height: 1.7; }
    .header { border-bottom: 2px solid #6366f1; padding-bottom: 20px; margin-bottom: 30px; }
    .logo { max-height: 50px; }
    .company-name { font-size: 22px; font-weight: 800; color: #4338ca; }
    .company-info { font-size: 11px; color: #64748b; margin-top: 5px; line-height: 1.4; }
    .doc-title { font-size: 24px; font-weight: 800; text-align: center; margin: 40px 0; color: #0f172a; text-transform: uppercase; letter-spacing: 1px; }
    .meta-table { width: 100%; border-collapse: collapse; margin-bottom: 35px; background: #f8fafc; border-radius: 8px; border: 1px solid #f1f5f9; }
    .meta-table td { padding: 12px; font-size: 13px; border-bottom: 1px solid #f1f5f9; }
    .meta-label { font-weight: 700; color: #475569; width: 140px; }
    .content { font-size: 14px; text-align: justify; white-space: pre-line; color: #334155; }
    .footer { margin-top: 80px; font-size: 11px; color: #94a3b8; border-top: 1px solid #e2e8f0; padding-top: 15px; text-align: center; }
    .signature-section { margin-top: 80px; display: flex; justify-content: space-between; }
    .sig-box { border-top: 1px solid #cbd5e1; width: 200px; text-align: center; padding-top: 8px; font-size: 12px; font-weight: 600; color: #475569; }
  </style>
</head>
<body>
  <div class="header">
    {{#if company.logoUrl}}
      <img class="logo" src="{{company.logoUrl}}" />
    {{else}}
      <div class="company-name">{{company.name}}</div>
    {{/if}}
    <div class="company-info">
      {{company.address}} &bull; Phone: {{company.phone}} &bull; Email: {{company.email}}
    </div>
  </div>

  <div class="doc-title">{{title}}</div>

  <table class="meta-table">
    <tr>
      <td class="meta-label">Date:</td>
      <td>{{formatDate date}}</td>
      <td class="meta-label">Recipient:</td>
      <td><strong>{{employee.firstName}} {{employee.lastName}}</strong></td>
    </tr>
    <tr>
      <td class="meta-label">Document Ref:</td>
      <td>{{id}}</td>
      <td class="meta-label">Email Address:</td>
      <td>{{employee.email}}</td>
    </tr>
  </table>

  <div class="content">
    {{content}}
  </div>

  <div class="signature-section">
    <div class="sig-box" style="float: left;">Authorized Signatory<br><small>{{company.name}}</small></div>
    <div class="sig-box" style="float: right;">Recipient Signature<br><small>{{employee.firstName}} {{employee.lastName}}</small></div>
    <div style="clear: both;"></div>
  </div>

  <div class="footer">
    This is an officially generated HR document from {{company.name}}.
  </div>
</body>
</html>
