<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<style>
  @page {
    size: A4;
    margin: 10mm 12mm 12mm 12mm;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    font-size: 8pt;
    color: #1e293b;
    line-height: 1.35;
    background: #ffffff;
    position: relative;
  }

  /* Subtle Corporate Watermark */
  .watermark {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-30deg);
    font-size: 64pt;
    font-weight: 900;
    color: rgba(99, 102, 241, 0.025);
    text-transform: uppercase;
    letter-spacing: 12px;
    pointer-events: none;
    z-index: 0;
    white-space: nowrap;
    user-select: none;
  }

  /* Top Header (Matching Uploaded Screenshot) */
  .top-header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-bottom: 12px;
    border-bottom: 1.5px solid #e2e8f0;
    margin-bottom: 12px;
    position: relative;
    z-index: 1;
  }
  .header-logo-container {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .header-logo-img {
    height: 38px;
    max-width: 150px;
    object-fit: contain;
  }
  .brand-logo-fallback {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .brand-icon {
    width: 32px;
    height: 32px;
    background: #0f172a;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #38bdf8;
    font-weight: 900;
    font-size: 14pt;
  }
  .brand-text-title {
    font-size: 13pt;
    font-weight: 900;
    color: #0f172a;
    letter-spacing: -0.4px;
    line-height: 1.05;
  }
  .brand-text-sub {
    font-size: 8pt;
    font-weight: 500;
    color: #64748b;
  }
  .header-divider {
    width: 1.5px;
    height: 38px;
    background: #cbd5e1;
  }
  .header-titles {
    flex: 1;
  }
  .header-pill {
    font-size: 7pt;
    font-weight: 800;
    color: #2563eb;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    margin-bottom: 2px;
  }
  .header-main-title {
    font-size: 15pt;
    font-weight: 900;
    color: #0f172a;
    letter-spacing: -0.4px;
    line-height: 1.1;
  }
  .header-desc {
    font-size: 7.5pt;
    color: #64748b;
    margin-top: 1px;
  }

  /* Client & Reporting Period Bar */
  .client-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 8px 12px;
    margin-bottom: 12px;
    position: relative;
    z-index: 1;
  }
  .client-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .client-name-group {
    font-size: 7.5pt;
    color: #64748b;
  }
  .client-name-val {
    font-size: 9.5pt;
    font-weight: 800;
    color: #0f172a;
  }
  .contact-group {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 8pt;
    font-weight: 700;
    color: #334155;
    border-left: 1px solid #cbd5e1;
    padding-left: 12px;
  }
  .contact-avatar {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #475569;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 6.5pt;
    font-weight: 800;
  }
  .client-right {
    text-align: right;
  }
  .period-header {
    font-size: 6.5pt;
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: 0.5px;
    color: #64748b;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
  }
  .period-val {
    font-size: 9pt;
    font-weight: 800;
    color: #0f172a;
    margin-top: 1px;
  }
  .ref-line {
    font-size: 6.5pt;
    color: #64748b;
    margin-top: 1px;
    font-family: monospace;
  }

  /* 4 Circular KPI Overview Cards */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 12px;
    position: relative;
    z-index: 1;
  }
  .kpi-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 8px 10px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .kpi-circle {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .kpi-completed-circle { background: #dcfce7; color: #16a34a; }
  .kpi-review-circle { background: #f3e8ff; color: #9333ea; }
  .kpi-progress-circle { background: #dbeafe; color: #2563eb; }
  .kpi-backlog-circle { background: #f1f5f9; color: #475569; }

  .kpi-info {
    display: flex;
    flex-direction: column;
  }
  .kpi-count {
    font-size: 13pt;
    font-weight: 900;
    color: #0f172a;
    line-height: 1;
  }
  .kpi-title {
    font-size: 7.5pt;
    font-weight: 800;
    color: #1e293b;
    margin-top: 2px;
  }
  .kpi-sub {
    font-size: 6pt;
    color: #64748b;
    margin-top: 1px;
  }

  /* Work Sections */
  .section-container {
    margin-bottom: 10px;
    position: relative;
    z-index: 1;
    page-break-inside: avoid;
  }
  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
    padding-bottom: 2px;
  }
  .section-title-left {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .num-circle {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 7pt;
    font-weight: 900;
    flex-shrink: 0;
  }
  .circle-completed { background: #dcfce7; color: #166534; }
  .circle-review { background: #f3e8ff; color: #6b21a8; }
  .circle-progress { background: #dbeafe; color: #1e40af; }
  .circle-backlog { background: #0f172a; color: #ffffff; }

  .section-name {
    font-size: 9pt;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.2px;
  }
  .section-pill-count {
    font-size: 6.5pt;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 9999px;
  }
  .pill-completed { background: #dcfce7; color: #15803d; }
  .pill-review { background: #f3e8ff; color: #7e22ce; }
  .pill-progress { background: #dbeafe; color: #1d4ed8; }
  .pill-backlog { background: #f1f5f9; color: #475569; }

  /* Structured Table */
  .work-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 7.5pt;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    overflow: hidden;
  }
  .work-table th {
    background: #f8fafc;
    color: #475569;
    font-weight: 700;
    font-size: 6.5pt;
    padding: 5px 8px;
    border-bottom: 1px solid #e2e8f0;
    text-align: left;
  }
  .work-table td {
    padding: 5px 8px;
    border-bottom: 1px solid #f1f5f9;
    vertical-align: middle;
  }
  .work-table tr:last-child td {
    border-bottom: none;
  }

  .th-num { width: 30px; text-align: center; }
  .th-title { }
  .th-ticket { width: 90px; }
  .th-assignee { width: 140px; }
  .th-status { width: 100px; }

  .td-num { text-align: center; color: #94a3b8; font-weight: 700; font-size: 7pt; }
  .td-title-bold { font-weight: 700; color: #0f172a; font-size: 7.5pt; }
  .td-title-desc { font-size: 6.5pt; color: #64748b; margin-top: 1px; }
  .ticket-code {
    font-family: monospace;
    font-weight: 800;
    font-size: 7pt;
    color: #4f46e5;
  }
  .assignee-box {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .assignee-avatar-chip {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #334155;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 6pt;
    font-weight: 800;
  }
  .assignee-name-text {
    font-size: 7pt;
    font-weight: 600;
    color: #334155;
  }

  .status-badge-chip {
    display: inline-block;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 6.5pt;
    font-weight: 800;
    text-align: center;
  }
  .sb-completed { background: #dcfce7; color: #15803d; }
  .sb-review { background: #fef3c7; color: #b45309; }
  .sb-progress { background: #e0e7ff; color: #4338ca; }
  .sb-backlog { background: #f1f5f9; color: #475569; }

  .empty-state-cell {
    text-align: center;
    padding: 10px 8px;
    color: #64748b;
    font-size: 7pt;
    font-style: italic;
  }
  .empty-dash {
    font-size: 10pt;
    color: #94a3b8;
    margin-bottom: 2px;
  }

  /* Bottom Dual Cards */
  .bottom-cards-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 10px;
    margin-bottom: 12px;
    page-break-inside: avoid;
    position: relative;
    z-index: 1;
  }
  .dual-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 10px 12px;
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .dual-icon-box {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #2563eb;
    flex-shrink: 0;
  }
  .dual-content {
    flex: 1;
  }
  .dual-title {
    font-size: 8pt;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 2px;
  }
  .dual-desc {
    font-size: 6.5pt;
    color: #64748b;
    line-height: 1.35;
  }

  /* Official Footer (Exact Match to Screenshot) */
  .official-footer {
    border-top: 1.5px solid #0f172a;
    padding-top: 10px;
    margin-top: 12px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    font-size: 6.5pt;
    color: #475569;
    line-height: 1.35;
    page-break-inside: avoid;
    position: relative;
    z-index: 1;
  }
  .footer-left {
    max-width: 65%;
  }
  .footer-company-name {
    font-size: 9.5pt;
    font-weight: 900;
    color: #0f172a;
    letter-spacing: -0.3px;
  }
  .footer-tagline {
    font-size: 7pt;
    font-weight: 700;
    color: #334155;
    margin-top: 1px;
  }
  .footer-address {
    margin-top: 3px;
    color: #475569;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .footer-contacts {
    margin-top: 3px;
    display: flex;
    align-items: center;
    gap: 8px;
    color: #64748b;
  }
  .footer-contacts a, .footer-contacts span {
    color: #0f172a;
    font-weight: 600;
  }

  .footer-right {
    text-align: right;
    min-width: 150px;
  }
  .footer-sig-img {
    height: 30px;
    max-width: 120px;
    object-fit: contain;
    margin-bottom: 3px;
  }
  .footer-sig-line {
    border-top: 1px solid #475569;
    padding-top: 3px;
    font-size: 7pt;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: 0.3px;
  }
  .footer-sig-sub {
    font-size: 6.5pt;
    color: #64748b;
    font-weight: 600;
    text-transform: uppercase;
  }
</style>
</head>
<body>

<!-- Watermark: Dynamically named after Company Profile -->
<div class="watermark">{{#if company.companyName}}{{company.companyName}}{{else}}NEURAVOLT{{/if}}</div>

<!-- TOP HEADER -->
<div class="top-header">
  <div class="header-logo-container">
    {{#if company.logoUrl}}
      <img src="{{company.logoUrl}}" class="header-logo-img" alt="{{company.companyName}}" />
    {{else}}
      <div class="brand-logo-fallback">
        <div class="brand-icon">N</div>
        <div>
          <div class="brand-text-title">{{#if company.companyName}}{{company.companyName}}{{else}}NEURAVOLT{{/if}}</div>
          <div class="brand-text-sub">Technology</div>
        </div>
      </div>
    {{/if}}
  </div>

  <div class="header-divider"></div>

  <div class="header-titles">
    <div class="header-pill">WEEKLY AMC SERVICE REPORT</div>
    <div class="header-main-title">AMC Service Report</div>
    <div class="header-desc">Executive Technical Progress &amp; SLA Performance Overview</div>
  </div>
</div>

<!-- CLIENT & REPORTING PERIOD STRIP -->
<div class="client-bar">
  <div class="client-left">
    <div class="client-name-group">
      <div>Client:</div>
      <div class="client-name-val">{{#if report.contract.client.name}}{{report.contract.client.name}}{{else}}Dewstream{{/if}}</div>
    </div>
    <div class="contact-group">
      <div class="contact-avatar">●</div>
      <span>{{#if report.contract.client.contactPerson}}{{report.contract.client.contactPerson}}{{else}}Hitesh Sahu{{/if}}</span>
    </div>
  </div>

  <div class="client-right">
    <div class="period-header">
      <span>📅</span>
      <span>REPORTING PERIOD</span>
    </div>
    <div class="period-val">{{formatDate report.periodStart}} – {{formatDate report.periodEnd}}</div>
    <div class="ref-line">Ref ID: {{report.reportNumber}} {{#if report.contract.contractNumber}}| Contract: {{report.contract.contractNumber}}{{/if}}</div>
  </div>
</div>

<!-- 4 CIRCULAR KPI OVERVIEW CARDS -->
<div class="kpi-grid">
  <!-- Card 1: Completed -->
  <div class="kpi-card">
    <div class="kpi-circle kpi-completed-circle">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </div>
    <div class="kpi-info">
      <div class="kpi-count">{{report.itemsCompleted}}</div>
      <div class="kpi-title">Completed</div>
      <div class="kpi-sub">Delivered &amp; Closed</div>
    </div>
  </div>

  <!-- Card 2: In Review -->
  <div class="kpi-card">
    <div class="kpi-circle kpi-review-circle">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
    </div>
    <div class="kpi-info">
      <div class="kpi-count">{{report.itemsInReview}}</div>
      <div class="kpi-title">In Review</div>
      <div class="kpi-sub">Awaiting Validation</div>
    </div>
  </div>

  <!-- Card 3: In Progress -->
  <div class="kpi-card">
    <div class="kpi-circle kpi-progress-circle">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"></circle>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
      </svg>
    </div>
    <div class="kpi-info">
      <div class="kpi-count">{{report.itemsInProgress}}</div>
      <div class="kpi-title">In Progress</div>
      <div class="kpi-sub">Active Engineering</div>
    </div>
  </div>

  <!-- Card 4: Backlog -->
  <div class="kpi-card">
    <div class="kpi-circle kpi-backlog-circle">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="8" y1="6" x2="21" y2="6"></line>
        <line x1="8" y1="12" x2="21" y2="12"></line>
        <line x1="8" y1="18" x2="21" y2="18"></line>
        <line x1="3" y1="6" x2="3.01" y2="6"></line>
        <line x1="3" y1="12" x2="3.01" y2="12"></line>
        <line x1="3" y1="18" x2="3.01" y2="18"></line>
      </svg>
    </div>
    <div class="kpi-info">
      <div class="kpi-count">{{report.itemsBacklog}}</div>
      <div class="kpi-title">Backlog</div>
      <div class="kpi-sub">Upcoming Priorities</div>
    </div>
  </div>
</div>

<!-- SECTION 1: Completed Deliverables -->
<div class="section-container">
  <div class="section-header">
    <div class="section-title-left">
      <div class="num-circle circle-completed">1</div>
      <div class="section-name">Completed Deliverables</div>
    </div>
    <div class="section-pill-count pill-completed">{{report.itemsCompleted}} items</div>
  </div>

  <table class="work-table">
    <thead>
      <tr>
        <th class="th-num">#</th>
        <th class="th-title">Task Title and Description</th>
        <th class="th-ticket">Ticket ID</th>
        <th class="th-assignee">Assignee</th>
        <th class="th-status">Status</th>
      </tr>
    </thead>
    <tbody>
      {{#if report.scopeExecuted.completed.length}}
        {{#each report.scopeExecuted.completed}}
          <tr>
            <td class="td-num">{{add @index 1}}</td>
            <td>
              <div class="td-title-bold">{{this.title}}</div>
              {{#if this.description}}<div class="td-title-desc">{{this.description}}</div>{{/if}}
            </td>
            <td><span class="ticket-code">{{this.ticketId}}</span></td>
            <td>
              <div class="assignee-box">
                <span class="assignee-avatar-chip">{{initials this.assignee}}</span>
                <span class="assignee-name-text">{{this.assignee}}</span>
              </div>
            </td>
            <td><span class="status-badge-chip sb-completed">Completed</span></td>
          </tr>
        {{/each}}
      {{else}}
        <tr>
          <td colspan="5" class="empty-state-cell">
            <div class="empty-dash">—</div>
            <div>No deliverables completed in this period.</div>
          </td>
        </tr>
      {{/if}}
    </tbody>
  </table>
</div>

<!-- SECTION 2: In Review -->
<div class="section-container">
  <div class="section-header">
    <div class="section-title-left">
      <div class="num-circle circle-review">2</div>
      <div class="section-name">In Review</div>
    </div>
    <div class="section-pill-count pill-review">{{report.itemsInReview}} items</div>
  </div>

  <table class="work-table">
    <thead>
      <tr>
        <th class="th-num">#</th>
        <th class="th-title">Task Title and Description</th>
        <th class="th-ticket">Ticket ID</th>
        <th class="th-assignee">Assignee</th>
        <th class="th-status">Status</th>
      </tr>
    </thead>
    <tbody>
      {{#if report.scopeExecuted.inReview.length}}
        {{#each report.scopeExecuted.inReview}}
          <tr>
            <td class="td-num">{{add @index 1}}</td>
            <td>
              <div class="td-title-bold">{{this.title}}</div>
              {{#if this.description}}<div class="td-title-desc">{{this.description}}</div>{{/if}}
            </td>
            <td><span class="ticket-code">{{this.ticketId}}</span></td>
            <td>
              <div class="assignee-box">
                <span class="assignee-avatar-chip">{{initials this.assignee}}</span>
                <span class="assignee-name-text">{{this.assignee}}</span>
              </div>
            </td>
            <td><span class="status-badge-chip sb-review">In Review</span></td>
          </tr>
        {{/each}}
      {{else}}
        <tr>
          <td colspan="5" class="empty-state-cell">
            <div class="empty-dash">—</div>
            <div>No deliverables currently in review.</div>
          </td>
        </tr>
      {{/if}}
    </tbody>
  </table>
</div>

<!-- SECTION 3: In Progress -->
<div class="section-container">
  <div class="section-header">
    <div class="section-title-left">
      <div class="num-circle circle-progress">3</div>
      <div class="section-name">In Progress</div>
    </div>
    <div class="section-pill-count pill-progress">{{report.itemsInProgress}} items</div>
  </div>

  <table class="work-table">
    <thead>
      <tr>
        <th class="th-num">#</th>
        <th class="th-title">Task Title and Description</th>
        <th class="th-ticket">Ticket ID</th>
        <th class="th-assignee">Assignee</th>
        <th class="th-status">Status</th>
      </tr>
    </thead>
    <tbody>
      {{#if report.scopeExecuted.inProgress.length}}
        {{#each report.scopeExecuted.inProgress}}
          <tr>
            <td class="td-num">{{add @index 1}}</td>
            <td>
              <div class="td-title-bold">{{this.title}}</div>
              {{#if this.description}}<div class="td-title-desc">{{this.description}}</div>{{/if}}
            </td>
            <td><span class="ticket-code">{{this.ticketId}}</span></td>
            <td>
              <div class="assignee-box">
                <span class="assignee-avatar-chip">{{initials this.assignee}}</span>
                <span class="assignee-name-text">{{this.assignee}}</span>
              </div>
            </td>
            <td><span class="status-badge-chip sb-progress">In Progress</span></td>
          </tr>
        {{/each}}
      {{else}}
        <tr>
          <td colspan="5" class="empty-state-cell">
            <div class="empty-dash">—</div>
            <div>No active development tasks in progress.</div>
          </td>
        </tr>
      {{/if}}
    </tbody>
  </table>
</div>

<!-- SECTION 4: Backlog / Upcoming Priorities -->
<div class="section-container">
  <div class="section-header">
    <div class="section-title-left">
      <div class="num-circle circle-backlog">4</div>
      <div class="section-name">Backlog / Upcoming Priorities</div>
    </div>
    <div class="section-pill-count pill-backlog">{{report.itemsBacklog}} items</div>
  </div>

  <table class="work-table">
    <thead>
      <tr>
        <th class="th-num">#</th>
        <th class="th-title">Task Title and Description</th>
        <th class="th-ticket">Ticket ID</th>
        <th class="th-assignee">Assignee</th>
        <th class="th-status">Status</th>
      </tr>
    </thead>
    <tbody>
      {{#if report.scopeExecuted.backlog.length}}
        {{#each report.scopeExecuted.backlog}}
          <tr>
            <td class="td-num">{{add @index 1}}</td>
            <td>
              <div class="td-title-bold">{{this.title}}</div>
              {{#if this.description}}<div class="td-title-desc">{{this.description}}</div>{{/if}}
            </td>
            <td><span class="ticket-code">{{this.ticketId}}</span></td>
            <td>
              <div class="assignee-box">
                <span class="assignee-avatar-chip">{{initials this.assignee}}</span>
                <span class="assignee-name-text">{{this.assignee}}</span>
              </div>
            </td>
            <td><span class="status-badge-chip sb-backlog">Backlog</span></td>
          </tr>
        {{/each}}
      {{else}}
        <tr>
          <td colspan="5" class="empty-state-cell">
            <div class="empty-dash">—</div>
            <div>No backlog or upcoming items scheduled.</div>
          </td>
        </tr>
      {{/if}}
    </tbody>
  </table>
</div>

<!-- DUAL BOTTOM CARDS (Effort & SLA Metric + Declaration Statement) -->
<div class="bottom-cards-grid">
  <!-- Left Card: Effort & SLA Metric -->
  <div class="dual-card">
    <div class="dual-icon-box">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="20" x2="18" y2="10"></line>
        <line x1="12" y1="20" x2="12" y2="4"></line>
        <line x1="6" y1="20" x2="6" y2="14"></line>
      </svg>
    </div>
    <div class="dual-content">
      <div class="dual-title">Effort &amp; SLA Metric</div>
      <div class="dual-desc">
        {{#if report.includeHours}}
          Total logged effort for period: <strong>{{formatNum report.hoursLogged}} hrs</strong>
          {{#if report.contract.allocatedHours}} · Monthly Allocation: {{formatNum report.contract.allocatedHours}} hrs{{/if}}
        {{else}}
          Effort breakdown hidden in this distribution format. Real-time deliverable statuses verified by QA &amp; Engineering.
        {{/if}}
      </div>
    </div>
  </div>

  <!-- Right Card: Declaration Statement -->
  <div class="dual-card">
    <div class="dual-icon-box">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="16" y1="13" x2="8" y2="13"></line>
        <line x1="16" y1="17" x2="8" y2="17"></line>
        <polyline points="10 9 9 9 8 9"></polyline>
      </svg>
    </div>
    <div class="dual-content">
      <div class="dual-title">Declaration Statement</div>
      <div class="dual-desc">
        {{#if report.declaration}}
          {{report.declaration}}
        {{else}}
          We hereby declare that the effort details provided above correspond to the tasks and support tickets successfully addressed during the billing cycle.
        {{/if}}
      </div>
    </div>
  </div>
</div>

<!-- OFFICIAL LEGAL FOOTER DYNAMICALLY FETCHED FROM https://teams.neuravolt.in/settings/company -->
<div class="official-footer">
  <div class="footer-left">
    <div class="footer-company-name">
      {{#if company.companyName}}{{company.companyName}}{{else}}NeuraVolt Technology{{/if}}
    </div>
    
    <div class="footer-tagline">
      {{#if company.legalName}}A brand of {{company.legalName}}{{else}}{{#if company.tagline}}{{company.tagline}}{{else}}A brand of VOLTNOVATE Solutions LLP{{/if}}{{/if}}
    </div>

    <div class="footer-address">
      <span>📍</span>
      <span>
        {{#if company.address}}{{company.address}}, {{/if}}
        {{#if company.city}}{{company.city}}, {{/if}}
        {{#if company.state}}{{company.state}} {{/if}}
        {{#if company.zip}}{{company.zip}}, {{/if}}
        {{#if company.country}}{{company.country}}{{else}}India{{/if}}
      </span>
    </div>

    <div class="footer-contacts">
      {{#if company.website}}
        <span>🌐 {{company.website}}</span>
      {{/if}}
      {{#if company.email}}
        <span>| ✉️ {{company.email}}</span>
      {{/if}}
      {{#if company.phone}}
        <span>| 📞 {{company.phone}}</span>
      {{/if}}
    </div>
  </div>

  <div class="footer-right">
    {{#if company.signatureUrl}}
      <img src="{{company.signatureUrl}}" class="footer-sig-img" alt="Authorized Signature" />
    {{/if}}
    <div class="footer-sig-line">Authorized Signatory</div>
    <div class="footer-sig-sub">
      {{#if company.legalName}}{{company.legalName}}{{else}}{{#if company.companyName}}{{company.companyName}}{{else}}VOLTNOVATE SOLUTIONS LLP{{/if}}{{/if}}
    </div>
  </div>
</div>

</body>
</html>
