<div style="color: #0f172a;">
  <table width="100%" border="0" cellspacing="0" cellpadding="0" style="margin-bottom: 14px;">
    <tr>
      <td valign="middle" style="font-size: 12px; font-weight: 600; color: #64748b;">{{#if kindLabel}}{{kindLabel}}{{else}}{{#if alertType}}{{alertType}}{{else}}Guardian{{/if}}{{/if}}</td>
      <td align="right" valign="middle">
        <span style="display: inline-block; padding: 3px 10px; font-size: 11px; font-weight: 700; border-radius: 9999px; {{#if (eq severity 'RESOLVED')}}background-color: #ecfdf5; color: #047857; border: 1px solid #a7f3d0;{{else}}{{#if (eq severity 'CRITICAL')}}background-color: #fef2f2; color: #b91c1c; border: 1px solid #fecaca;{{else}}{{#if (eq severity 'EMERGENCY')}}background-color: #fef2f2; color: #b91c1c; border: 1px solid #fecaca;{{else}}{{#if (eq severity 'WARNING')}}background-color: #fffbeb; color: #b45309; border: 1px solid #fde68a;{{else}}background-color: #f1f5f9; color: #475569; border: 1px solid #e2e8f0;{{/if}}{{/if}}{{/if}}{{/if}}">{{#if severityLabel}}{{severityLabel}}{{else}}{{#if severity}}{{severity}}{{else}}Alert{{/if}}{{/if}}</span>
      </td>
    </tr>
  </table>

  <h2 style="margin: 0 0 6px 0; font-size: 19px; line-height: 1.35; color: #0f172a;">{{#if emailTitle}}{{emailTitle}}{{else}}{{#if title}}{{title}}{{else}}Guardian alert{{/if}}{{/if}}</h2>
  {{#if emailTarget}}<div style="font-size: 13px; color: #64748b; margin-bottom: 18px;">Where: <strong style="color: #334155;">{{emailTarget}}</strong></div>{{else}}{{#if targetName}}<div style="font-size: 13px; color: #64748b; margin-bottom: 18px;">Where: <strong style="color: #334155;">{{targetName}}</strong></div>{{/if}}{{/if}}

  {{#if intro}}
  <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 12px 14px; margin-bottom: 18px; font-size: 13px; line-height: 1.55; color: #334155;">
    <strong style="color: #0f172a;">Why you got this email:</strong> {{intro}}
  </div>
  {{/if}}

  {{#if facts}}
  <div style="font-size: 12px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px;">What happened</div>
  <table width="100%" border="0" cellspacing="0" cellpadding="0" style="border: 1px solid #e2e8f0; border-radius: 8px; margin-bottom: 18px; font-size: 13px; border-collapse: separate;">
    {{#each facts}}
    <tr>
      <td valign="top" style="padding: 8px 12px; {{#unless @first}}border-top: 1px solid #f1f5f9;{{/unless}} color: #64748b; width: 34%;">{{label}}</td>
      <td valign="top" style="padding: 8px 12px; {{#unless @first}}border-top: 1px solid #f1f5f9;{{/unless}} color: #0f172a; word-break: break-word;">{{value}}</td>
    </tr>
    {{/each}}
  </table>
  {{/if}}

  {{#if failing}}
  <table width="100%" border="0" cellspacing="0" cellpadding="0" style="border: 1px solid #e2e8f0; border-radius: 8px; margin-bottom: 18px; font-size: 13px; border-collapse: separate;">
    <tr style="background-color: #f8fafc;">
      <td style="padding: 8px 12px; font-weight: 600; color: #475569;">Failing URL</td>
      <td style="padding: 8px 12px; font-weight: 600; color: #475569;" align="right">Status</td>
      <td style="padding: 8px 12px; font-weight: 600; color: #475569;" align="right">Errors</td>
    </tr>
    {{#each failing}}
    <tr>
      <td style="padding: 8px 12px; border-top: 1px solid #f1f5f9; font-family: monospace; color: #0f172a; word-break: break-all;">{{#if (ne method 'GET')}}{{method}} {{/if}}{{path}}</td>
      <td style="padding: 8px 12px; border-top: 1px solid #f1f5f9; color: #b91c1c;" align="right">{{status}}</td>
      <td style="padding: 8px 12px; border-top: 1px solid #f1f5f9; color: #0f172a;" align="right">{{count}}</td>
    </tr>
    {{/each}}
  </table>
  {{/if}}

  {{#if why}}
  <div style="font-size: 14px; line-height: 1.6; color: #334155; margin-bottom: 18px;"><strong style="color: #0f172a;">Likely cause:</strong> {{why}}</div>
  {{/if}}

  {{#if steps}}
  <div style="font-size: 12px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px;">What to do</div>
  <ol style="margin: 0 0 18px 0; padding-left: 20px; font-size: 14px; line-height: 1.6; color: #334155;">
    {{#each steps}}<li style="margin-bottom: 4px;">{{this}}</li>{{/each}}
  </ol>
  {{/if}}

  {{#unless facts}}{{#if message}}
  <div style="font-size: 14px; line-height: 1.6; color: #334155; white-space: pre-line; margin-bottom: 18px;">{{message}}</div>
  {{/if}}{{/unless}}

  {{#if suggestedRemediation}}
  <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px 14px; margin-bottom: 18px;">
    <div style="font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 6px;">Suggested fix (needs your approval, not run)</div>
    <div style="font-size: 12px; font-family: monospace; color: #0f172a; word-break: break-all;">{{suggestedRemediation}}</div>
  </div>
  {{/if}}

  {{#if consoleUrl}}
  <div style="margin: 22px 0 6px 0;">
    <a href="{{consoleUrl}}" target="_blank" style="display: inline-block; background-color: {{brand.accent}}; color: #ffffff; text-decoration: none; padding: 11px 22px; font-size: 14px; font-weight: 600; border-radius: 8px;">Open this alert</a>
  </div>
  {{/if}}

  {{#if emailPolicyNote}}<p style="margin: 18px 0 0 0; font-size: 12px; line-height: 1.5; color: #94a3b8;">{{emailPolicyNote}}</p>{{/if}}
</div>
